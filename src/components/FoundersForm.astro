---
const PORTAL_ID = '246356324';
const FORM_ID = '66b86cc2-3710-48bd-8c08-c94c1198dc0e';
const tierChoices = ['Substrate Circle ($5K+)', 'Root Circle ($25K+)', 'Hearth Circle ($75K+)', 'Maloka Circle ($250K+)', 'Old Growth Circle ($1M+)', 'Not sure yet — let’s talk'];
---
<form class="signup" id="foundersForm" data-portal={PORTAL_ID} data-form={FORM_ID}>
  <div class="field-row">
    <label class="field"><span class="field-label">First name</span><input type="text" name="firstname" required autocomplete="given-name" /></label>
    <label class="field"><span class="field-label">Last name</span><input type="text" name="lastname" autocomplete="family-name" /></label>
  </div>
  <div class="field-row">
    <label class="field"><span class="field-label">Email</span><input type="email" name="email" required autocomplete="email" placeholder="you@example.com" /></label>
    <label class="field"><span class="field-label">Phone</span><input type="tel" name="phone" autocomplete="tel" placeholder="(000) 000-0000" /></label>
  </div>
  <label class="field">
    <span class="field-label">Tier you're drawn to</span>
    <select name="tier" id="tierSelect">
      <option value="">Choose one…</option>
      {tierChoices.map((t) => <option>{t}</option>)}
    </select>
  </label>
  <button type="submit" class="btn btn-primary signup-submit">Begin the conversation</button>
  <p class="signup-status" id="foundersStatus" role="status"></p>
  <p class="signup-fine">We'll reach out personally — there's no online checkout. The pace is deliberate, because the relationship is.</p>
</form>

<style>
  .signup { display: flex; flex-direction: column; gap: var(--s-4); max-width: 560px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); }
  .field { display: flex; flex-direction: column; gap: var(--s-2); }
  .field-label { font-size: var(--t-sm); color: var(--ink-soft); font-weight: 400; }
  .signup input, .signup select { background: var(--bone-warm); border: 1px solid var(--bone-edge); border-radius: var(--r-md); padding: 12px 14px; font-size: var(--t-base); color: var(--ink); transition: border-color var(--d-fast) var(--ease-out); }
  .signup input:focus, .signup select:focus { outline: none; border-color: var(--peach); }
  .signup select.flash { border-color: var(--peach); box-shadow: 0 0 0 3px var(--peach-tint); transition: box-shadow var(--d-base) var(--ease-out); }
  .signup-submit { align-self: flex-start; margin-top: var(--s-2); }
  .signup-status { font-size: var(--t-sm); min-height: 1em; }
  .signup-status.ok { color: var(--moss); }
  .signup-status.err { color: var(--rust); }
  .signup-fine { font-size: var(--t-xs); color: var(--ink-faint); max-width: 48ch; }
  @media (max-width: 520px) { .field-row { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('foundersForm') as HTMLFormElement | null;
  const status = document.getElementById('foundersStatus');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !status) return;
    const portal = form.dataset.portal, formId = form.dataset.form;
    const data = new FormData(form);
    const g = (n: string) => String(data.get(n) || '').trim();
    const tier = g('tier');
    const btn = form.querySelector('.signup-submit') as HTMLButtonElement;
    // All fields map to default HubSpot properties; tier is folded into the note so it's never lost.
    const fields = [
      { name: 'firstname', value: g('firstname') },
      { name: 'lastname', value: g('lastname') },
      { name: 'email', value: g('email') },
      { name: 'phone', value: g('phone') },
      { name: 'message', value: tier ? `Founder's Circle inquiry — tier of interest: ${tier}` : "Founder's Circle inquiry" },
    ].filter((f) => f.value !== '');
    btn.disabled = true; status.className = 'signup-status'; status.textContent = 'Sending…';
    try {
      const res = await fetch(`https://api.hsforms.com/submissions/v3/integration/submit/${portal}/${formId}`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fields, context: { pageUri: location.href, pageName: document.title } }),
      });
      if (!res.ok) throw new Error(String(res.status));
      status.className = 'signup-status ok';
      status.textContent = "Thank you — your note is with the founding team. We'll be in touch personally.";
      form.reset();
    } catch {
      status.className = 'signup-status err';
      status.textContent = 'Something went wrong — please email founders@lichen.health directly.';
    } finally { btn.disabled = false; }
  });
</script>
