---
// The authentic phone shell for hand-built mockups (founder 2026-08-05):
// true iPhone proportions (390:844 — the same viewport the real screenshots
// on /care /business /platform were captured at), the app's real top-bar
// chrome (menu · back · section mark · avatar · bell) and the seven-door
// bottom nav in the hairline icon style. Content goes in the default slot;
// the `center` slot carries the section mark glyph.
import AppIcon from './AppIcon.astro';
export interface Props {
  initial?: string;          // avatar letter(s); omit for the plain dot
  active?: 'home' | 'concierge' | 'chat' | 'calendar' | 'saved' | 'maps' | 'profile';
  /** Space pages carry no section mark — the kind's glyph sits beside its
   *  word under the name instead (founder 2026-08-05). */
  mark?: boolean;
  /** Frame width in px. 300 is the standalone size; the five ways-in
   *  mockups run narrower so the section doesn't scroll forever. */
  w?: number;
}
const { initial = 'G', active = 'home', mark = true, w = 300 } = Astro.props;
const NAV: { key: Props['active']; label: string }[] = [
  { key: 'home', label: 'Home' }, { key: 'concierge', label: 'Concierge' },
  { key: 'chat', label: 'Chat' }, { key: 'calendar', label: 'Calendar' },
  { key: 'saved', label: 'Saved' }, { key: 'maps', label: 'Maps' },
  { key: 'profile', label: 'Profile' },
];
---
<div class="pf" style={`width:${w}px`}>
  <div class="pf-notch" aria-hidden="true"></div>
  <div class="pf-top" aria-hidden="true">
    <span class="pf-circ"><AppIcon name="menu" size={15} /></span>
    <span class="pf-circ"><AppIcon name="chevron-left" size={15} /></span>
    {mark && <span class="pf-circ pf-mark"><slot name="center">
      <AppIcon name="concierge" size={26} />
    </slot></span>}
    <span class="pf-gap"></span>
    <span class="pf-avatar">{initial}</span>
    <span class="pf-circ"><AppIcon name="bell" size={15} /></span>
  </div>
  <div class="pf-body"><slot /></div>
  <nav class="pf-nav" aria-hidden="true">
    {NAV.map((n) => (
      <span class={'pf-nav-item' + (n.key === active ? ' is-active' : '')}>
        {n.key === 'home' && <AppIcon name="home" size={17} />}
        {n.key === 'concierge' && <AppIcon name="concierge" size={17} />}
        {n.key === 'chat' && <AppIcon name="chat" size={17} />}
        {n.key === 'calendar' && <AppIcon name="calendar" size={17} />}
        {n.key === 'saved' && <AppIcon name="saved" size={17} />}
        {n.key === 'maps' && <AppIcon name="maps" size={17} />}
        {n.key === 'profile' && <AppIcon name="profile" size={17} />}
        <em>{n.label}</em>
      </span>
    ))}
  </nav>
</div>

<style>
  .pf {
    width: 300px; aspect-ratio: 390 / 844;
    border: 4px solid #1a1a1a; border-radius: 19px;
    background: var(--bone); overflow: hidden;
    box-shadow: 0 18px 44px rgba(18, 24, 28, 0.22);
    display: flex; flex-direction: column;
  }
  .pf-notch { width: 84px; height: 8px; background: #1a1a1a; border-radius: 0 0 8px 8px; margin: 0 auto; flex-shrink: 0; }
  /* The real top bar: 38pt circles centred ~41pt down, the section mark a
     68pt disc overhanging below them, and real air before the content. */
  .pf-top {
    position: relative;
    display: flex; align-items: flex-start; gap: 6px;
    padding: 17px 10px 0; height: 72px; flex-shrink: 0;
  }
  /* Transparent, hairline-ringed — the real top bar has no white discs. */
  .pf-circ {
    width: 29px; height: 29px; border-radius: 50%; flex-shrink: 0;
    border: 1px solid var(--ink); background: transparent;
    color: var(--ink);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .pf-circ :global(svg) { width: 15px; height: 15px; }
  /* The section mark is the big centred disc in the real top bar. It stays
     quiet — the bottom nav is what shows you which section you're in. */
  .pf-mark {
    position: absolute; left: 50%; top: 14px; transform: translateX(-50%);
    width: 52px; height: 52px;
  }
  .pf-mark :global(svg) { width: 26px; height: 26px; }
  /* The app pins section-mark strokes to a 1.2px hairline in SCREEN px
     (TopBar.css, PR #100) — at this scale the icons' native weights would
     otherwise render ~2x the ring. */
  .pf-mark :global(svg *) { vector-effect: non-scaling-stroke; stroke-width: 1.2px; }
  .pf-gap { flex: 1; }
  .pf-avatar {
    width: 29px; height: 29px; border-radius: 50%; flex-shrink: 0;
    background: #A78BBA; color: #fff; font-size: 11px; font-weight: 600;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .pf-body { flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column; }
  .pf-nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 11px 8px 16px; border-top: 1px solid var(--bone-edge);
    background: var(--bone); flex-shrink: 0;
  }
  .pf-nav-item {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    color: var(--ink-muted); flex: 1; min-width: 0;
  }
  .pf-nav-item :global(svg) { width: 17px; height: 17px; }
  .pf-nav-item em {
    font-style: normal; font-family: var(--font-mono); font-size: 6.5px;
    letter-spacing: 0.05em; text-transform: uppercase;
  }
  .pf-nav-item.is-active { color: var(--peach-deep); }
</style>
