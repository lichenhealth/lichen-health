---
// The authentic phone shell for hand-built mockups (founder 2026-08-05):
// true iPhone proportions (390:844 — the same viewport the real screenshots
// on /care /business /platform were captured at), the app's real top-bar
// chrome (menu · back · section mark · avatar · bell) and the seven-door
// bottom nav in the hairline icon style. Content goes in the default slot;
// the `center` slot carries the section mark glyph.
export interface Props {
  initial?: string;          // avatar letter(s); omit for the plain dot
  active?: 'home' | 'concierge' | 'chat' | 'calendar' | 'saved' | 'maps' | 'profile';
}
const { initial = 'G', active = 'home' } = Astro.props;
const NAV: { key: Props['active']; label: string }[] = [
  { key: 'home', label: 'Home' }, { key: 'concierge', label: 'Concierge' },
  { key: 'chat', label: 'Chat' }, { key: 'calendar', label: 'Calendar' },
  { key: 'saved', label: 'Saved' }, { key: 'maps', label: 'Maps' },
  { key: 'profile', label: 'Profile' },
];
---
<div class="pf">
  <div class="pf-notch" aria-hidden="true"></div>
  <div class="pf-top" aria-hidden="true">
    <span class="pf-circ">
      <svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </span>
    <span class="pf-circ">
      <svg viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <span class="pf-circ pf-mark"><slot name="center">
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 20s-7-4.5-7-9.5A4 4 0 0112 7a4 4 0 017 3.5C19 15.5 12 20 12 20z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
    </slot></span>
    <span class="pf-gap"></span>
    <span class="pf-avatar">{initial}</span>
    <span class="pf-circ">
      <svg viewBox="0 0 24 24" fill="none"><path d="M6 16v-5a6 6 0 0112 0v5l1.5 2h-15L6 16z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M10 20a2 2 0 004 0" stroke="currentColor" stroke-width="1.4"/></svg>
    </span>
  </div>
  <div class="pf-body"><slot /></div>
  <nav class="pf-nav" aria-hidden="true">
    {NAV.map((n) => (
      <span class={'pf-nav-item' + (n.key === active ? ' is-active' : '')}>
        {n.key === 'home' && <svg viewBox="0 0 24 24" fill="none"><path d="M4 11l8-7 8 7v9h-5v-6h-6v6H4v-9z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>}
        {n.key === 'concierge' && <svg viewBox="0 0 24 24" fill="none"><path d="M12 20s-7-4.5-7-9.5A4 4 0 0112 7a4 4 0 017 3.5C19 15.5 12 20 12 20z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>}
        {n.key === 'chat' && <svg viewBox="0 0 24 24" fill="none"><path d="M4 6a2 2 0 012-2h12a2 2 0 012 2v8a2 2 0 01-2 2H9l-5 4V6z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>}
        {n.key === 'calendar' && <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="6" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M4 10h16M8 3v5M16 3v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>}
        {n.key === 'saved' && <svg viewBox="0 0 24 24" fill="none"><path d="M7 4h10v16l-5-4-5 4V4z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>}
        {n.key === 'maps' && <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.4"/><path d="M5 9c3 2 5-1 8 1s5 0 6-1M6 17c2-2 5 1 7-1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>}
        {n.key === 'profile' && <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.4"/><path d="M5 20a7 7 0 0114 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>}
        <em>{n.label}</em>
      </span>
    ))}
  </nav>
</div>

<style>
  .pf {
    width: 300px; aspect-ratio: 390 / 844;
    border: 4px solid #1a1a1a; border-radius: 19px;
    background: var(--bone); overflow: hidden;
    box-shadow: 0 18px 44px rgba(18, 24, 28, 0.22);
    display: flex; flex-direction: column;
  }
  .pf-notch { width: 84px; height: 8px; background: #1a1a1a; border-radius: 0 0 8px 8px; margin: 0 auto; flex-shrink: 0; }
  .pf-top {
    display: flex; align-items: center; gap: 6px;
    padding: 8px 10px 8px; flex-shrink: 0;
  }
  .pf-circ {
    width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
    border: 1px solid var(--bone-edge); background: var(--bone-warm);
    color: var(--ink-soft);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .pf-circ svg { width: 13px; height: 13px; }
  .pf-mark { margin-left: 12px; border-color: var(--peach); color: var(--peach-deep); }
  .pf-gap { flex: 1; }
  .pf-avatar {
    width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
    background: #A78BBA; color: #fff; font-size: 10px; font-weight: 600;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .pf-body { flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column; }
  .pf-nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 8px 12px; border-top: 1px solid var(--bone-edge);
    background: var(--bone); flex-shrink: 0;
  }
  .pf-nav-item {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    color: var(--ink-muted); flex: 1; min-width: 0;
  }
  .pf-nav-item svg { width: 15px; height: 15px; }
  .pf-nav-item em {
    font-style: normal; font-family: var(--font-mono); font-size: 5.5px;
    letter-spacing: 0.05em; text-transform: uppercase;
  }
  .pf-nav-item.is-active { color: var(--peach-deep); }
</style>
