---
// Two realistic phone mockups, side by side (founder 2026-08-05; refreshed
// 2026-10-05 against the REAL buildout — founder: "update the mockups…to
// reflect the true buildout of the actual platform"): the assistant on the
// left is the feed as it actually ships — a two-sided CONVERSATION (bubbles
// with speakers and faces, the thread icon rail, Claude's real small hands:
// it adds the task and the calendar entry itself) — not a card list. The
// right phone keeps the protected course recording; its retired feed tabs
// (All/Social/Actionable) are gone and the icon row speaks the doors
// grammar the app ships today, Feed door included. Hand-built in the app's
// own visual vocabulary (bone, peach, silicon blue, hairlines) rather than
// screenshots, so the scenarios can be ideal while the UI stays true.
// PhoneFrame supplies the authentic chrome: true 390:844 proportions, the
// app's top bar and the real seven-door bottom nav.
import PhoneFrame from './PhoneFrame.astro';
import AppIcon from './AppIcon.astro';
---
<div class="ph-pair">
  <div class="ph-col">
  <PhoneFrame initial="G" active="home" mark={false}>
    <div class="ph-ai">
      <span class="ph-ai-avatar">
        <AppIcon name="brain" size={22} />
        <span class="ph-ai-el">Si</span>
      </span>
      <p class="ph-ai-name">AI Assistant</p>
      <p class="ph-ai-scope">Your Lichen Partner</p>
    </div>
    {/* The thread rail — the relationship is threaded by platform section
        (General · Profile · Marketplace · Events · Calendar · Concierge),
        each an icon circle; the open thread is lit. */}
    <div class="ph-rail" aria-hidden="true">
      <span class="ph-rail-circ is-on"><AppIcon name="brain" size={12} /></span>
      <span class="ph-rail-circ"><AppIcon name="profile" size={12} /></span>
      <span class="ph-rail-circ"><AppIcon name="store" size={12} /></span>
      <span class="ph-rail-circ"><AppIcon name="rsvp" size={12} /></span>
      <span class="ph-rail-circ"><AppIcon name="calendar" size={12} /></span>
      <span class="ph-rail-circ"><AppIcon name="concierge" size={12} /></span>
    </div>
    <div class="ph-body ph-body--chat">
      <p class="ph-spk">Claude · <em>AI Assistant</em></p>
      <div class="ph-run">
        <span class="ph-mini"><AppIcon name="brain" size={11} /></span>
        <div class="ph-bub ph-bub--match">
          <p><strong><span class="ph-ref">Rosa</span> accepted your trade</strong> — her elderberry syrup for your garden hours, Thursday afternoon. And a gift matches what you&rsquo;re seeking: a <span class="ph-ref">cedar planter box</span>, offered by someone <span class="ph-ref">Melanie</span> trusts, four miles away.</p>
        </div>
      </div>
      <div class="ph-run">
        <span class="ph-mini"><AppIcon name="brain" size={11} /></span>
        <div class="ph-bub">
          <p><strong>Tomorrow:</strong> your 3pm blood draw, then the Grange potluck at 5. Want the seed packets on your to-dos?</p>
        </div>
      </div>
      <div class="ph-run ph-run--me">
        <div class="ph-bub ph-bub--me">
          <p>Yes — and put Thursday with Rosa on my calendar.</p>
        </div>
        <span class="ph-mini ph-mini--me">G</span>
      </div>
      <div class="ph-run">
        <span class="ph-mini"><AppIcon name="brain" size={11} /></span>
        <div class="ph-bub">
          <p>Done — seed packets are on tomorrow&rsquo;s list, and Thursday 2pm with Rosa is on your calendar. <span class="ph-done">✓</span></p>
        </div>
      </div>
      <p class="ph-foot">Carbon decides; silicon organizes.</p>
      <div class="ph-ask">
        <span class="ph-ask-btn"><AppIcon name="image" size={14} /></span>
        <span class="ph-ask-btn"><AppIcon name="mic" size={14} /></span>
        <span class="ph-ask-input">Ask about any of this…</span>
        <span class="ph-ask-send"><AppIcon name="send" size={12} /></span>
      </div>
    </div>
  </PhoneFrame>
  <p class="ph-colcap">The assistant helps you live most fully, organizing your needs digitally so you can spend your time more organically.</p>
  </div>

  <div class="ph-col">
  <PhoneFrame initial="M" active="home" mark={false}>
    <div class="ph-space">
      <img class="ph-space-ava" src="/img/2026/01/natural-medicine-avatar.jpg" alt="" loading="lazy" />
      <p class="ph-space-name">Natural Medicine Cohort 2026</p>
      <p class="ph-space-kind">Group <AppIcon name="groups" size={15} /></p>
    </div>
    {/* The retired All/Social/Actionable feed tabs are GONE (the app
        dropped them — the icon row leads with the Feed door now). Doors in
        the platform's real order: search · post · assistant, the hairline,
        then Feed and this group's own rooms. */}
    <div class="ph-doors" aria-hidden="true">
      <span class="ph-door">
        <span class="ph-door-circ"><AppIcon name="search" size={13} /></span>
        <em>Search</em>
      </span>
      <span class="ph-door">
        <span class="ph-door-circ"><AppIcon name="plus" size={13} /></span>
        <em>Post</em>
      </span>
      <span class="ph-door ph-door--aioff">
        <span class="ph-door-circ"><AppIcon name="brain" size={13} /><span class="ph-door-slash"></span></span>
        <em>AI</em>
      </span>
      <span class="ph-doors-gap"></span>
      <span class="ph-door">
        <span class="ph-door-circ"><AppIcon name="newsfeed" size={13} /></span>
        <em>Feed</em>
      </span>
      <span class="ph-door">
        <span class="ph-door-circ"><AppIcon name="chat" size={13} /></span>
        <em>Chat</em>
      </span>
      <span class="ph-door ph-door--on">
        <span class="ph-door-circ"><AppIcon name="graduation-cap" size={13} /></span>
        <em>Courses</em>
      </span>
      <span class="ph-door">
        <span class="ph-door-circ"><AppIcon name="rsvp" size={13} /></span>
        <em>Events</em>
      </span>
      <span class="ph-door">
        <span class="ph-door-circ"><AppIcon name="member-heart" size={13} /></span>
        <em>Members</em>
      </span>
    </div>
    <div class="ph-body">
      <div class="ph-video" role="img" aria-label="A course video player, paused on the Weekend 2 recording — hands grinding herbs in a mortar.">
        <img class="ph-video-still" src="/img/2026/01/natural-medicine-still.jpg" alt="" loading="lazy" />
        <span class="ph-play" aria-hidden="true">▶</span>
        <span class="ph-dur">1:48:22</span>
      </div>
      <p class="ph-lesson">Natural Medicine Training · Weekend 2</p>
      <div class="ph-protect">
        <p class="ph-protect-line"><strong>Downloads, recordings &amp; AI</strong> — disabled <span class="ph-protect-chev">&#8964;</span></p>
        <p class="ph-protect-sub">My plant allies asked that this teaching stay in the room. Sit with it live, or here — but it doesn&rsquo;t travel, and no machine reads it.</p>
      </div>
      <div class="ph-rows">
        <p class="ph-row"><span class="ph-row-done">✓</span> Weekend 1 — opening the four directions</p>
        <p class="ph-row ph-row--now"><span class="ph-row-play">●</span> Weekend 2 — full recording</p>
      </div>
    </div>
  </PhoneFrame>
  <p class="ph-colcap">A teacher&rsquo;s channeled wisdom is protected as her sacred plant allies have requested — downloads off, recording off, and never read by AI, ever.</p>
  </div>
</div>

<style>
  .ph-pair {
    display: flex; justify-content: center; gap: var(--s-6);
    margin-top: var(--s-8); flex-wrap: wrap;
  }
  .ph-head {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 16px 12px; border-bottom: 1px solid var(--bone-edge);
  }
  .ph-title { font-weight: 600; font-size: 14px; color: var(--ink); }
  .ph-sub { font-size: 11px; color: var(--ink-muted); margin-top: 1px; }
  .ph-body { padding: 12px 12px 16px; }
  /* The assistant page is shaped like a profile: picture, then the name —
     the mark wearing its silicon badge in the elements blue. */
  .ph-ai { text-align: center; padding: 3px 14px 5px; }
  .ph-ai-avatar {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--sky); color: var(--sky);
  }
  .ph-ai-el {
    position: absolute; top: -2px; right: -4px;
    min-width: 16px; height: 16px; padding: 0 4px; border-radius: 999px;
    background: var(--sky); color: #fff;
    font-family: var(--font-mono); font-size: 7.5px; font-weight: 600;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .ph-ai-name { font-family: var(--font-display); font-size: 14px; color: var(--ink); margin-top: 4px; }
  .ph-ai-scope {
    font-family: var(--font-mono); font-size: 7.5px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--sky); margin-top: 2px;
  }
  /* A space's home screen: avatar, name, kind — no banner behind it. */
  .ph-space { text-align: center; padding: 8px 14px 8px; }
  .ph-space-ava {
    width: 52px; height: 52px; border-radius: 50%;
    object-fit: cover; display: inline-block;
  }
  .ph-space-name { font-family: var(--font-display); font-size: 15px; color: var(--ink); margin-top: 7px; line-height: 1.2; }
  .ph-space-kind {
    font-size: 10.5px; color: var(--ink-muted); margin-top: 2px;
    display: inline-flex; align-items: center; gap: 5px;
  }
  .ph-space-kind :global(svg) { width: 15px; height: 15px; color: var(--ink-soft); }
  /* The section doors, in the platform's real order: search · post ·
     assistant, then the hairline, then Feed + this space's own rooms. */
  .ph-doors { display: flex; align-items: flex-start; gap: 4px; padding: 0 8px 8px; }
  .ph-door { display: flex; flex-direction: column; align-items: center; gap: 3px; flex: 1; min-width: 0; }
  .ph-door-circ {
    width: 26px; height: 26px; border-radius: 50%;
    border: 1px solid var(--bone-edge); background: var(--bone-warm); color: var(--ink-soft);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .ph-door-circ :global(svg) { width: 13px; height: 13px; }
  .ph-door em {
    font-style: normal; font-family: var(--font-mono); font-size: 5.5px;
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-muted);
  }
  .ph-door--on .ph-door-circ { background: var(--peach); border-color: var(--peach); color: var(--bone-warm); }
  .ph-door--on em { color: var(--peach-deep); }
  .ph-door--aioff .ph-door-circ { color: var(--ink-faint); position: relative; }
  .ph-door-slash {
    position: absolute; width: 17px; height: 1.2px; background: var(--ink-faint);
    transform: rotate(-45deg); border-radius: 1px;
  }
  .ph-door--aioff em { color: var(--ink-faint); }
  .ph-doors-gap { width: 1px; align-self: stretch; background: var(--bone-edge); flex-shrink: 0; margin: 2px 3px; }
  /* THE CONVERSATION (refreshed 2026-10-05 to the app's real grammar):
     Claude's bubbles sit LEFT with the silicon face beside them, yours sit
     RIGHT in the peach tint with your own face — every utterance wears its
     speaker. A conversation bottom-anchors like the real screen, so if
     words outgrow the frame the OLDEST clip at the top, never the newest. */
  .ph-body--chat {
    display: flex; flex-direction: column; justify-content: flex-end;
    flex: 1; min-height: 0; overflow: hidden;
  }
  .ph-spk { font-size: 8.5px; font-weight: 600; color: var(--ink-muted); padding-left: 26px; margin-bottom: 2px; }
  .ph-spk em { font-style: normal; font-weight: 400; color: var(--ink-faint); }
  .ph-run { display: flex; align-items: flex-end; gap: 5px; margin-bottom: 6px; }
  .ph-run--me { justify-content: flex-end; }
  .ph-mini {
    width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0;
    border: 1px solid var(--sky); color: var(--sky); background: var(--bone);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .ph-mini--me {
    border: 0; background: #A78BBA; color: #fff;
    font-size: 9px; font-weight: 600;
  }
  .ph-bub {
    background: var(--bone-warm); border: 1px solid var(--bone-edge);
    border-radius: 11px 11px 11px 4px;
    padding: 7px 10px; max-width: 88%;
  }
  .ph-bub p { font-size: 10.5px; line-height: 1.42; color: var(--ink-soft); }
  .ph-bub p strong { color: var(--ink); font-weight: 600; }
  /* Inside the assistant's world, selection and emphasis wear silicon blue
     rather than peach (founder 2026-08-05). */
  .ph-bub--match { border-color: var(--sky); background: color-mix(in srgb, var(--sky) 12%, transparent); }
  .ph-bub--me {
    background: var(--peach-tint, color-mix(in srgb, var(--peach) 16%, transparent));
    border-color: color-mix(in srgb, var(--peach) 45%, transparent);
    border-radius: 11px 11px 4px 11px;
  }
  .ph-done { color: var(--moss, #4A5D3F); font-weight: 600; }
  /* The thread rail — each platform section's icon as a small circle, the
     doors grammar; the open thread deepens. */
  .ph-rail { display: flex; justify-content: center; gap: 7px; padding: 2px 12px 6px; }
  .ph-rail-circ {
    width: 22px; height: 22px; border-radius: 50%;
    border: 1px solid var(--bone-edge); background: var(--bone-warm); color: var(--ink-soft);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .ph-rail-circ.is-on { border-color: var(--sky); color: var(--sky); background: color-mix(in srgb, var(--sky) 10%, transparent); }
  .ph-ref {
    color: var(--sky); font-weight: 600;
    border-bottom: 1px solid color-mix(in srgb, var(--sky) 45%, transparent);
  }
  .ph-ask {
    display: flex; align-items: center; gap: 4px; margin-top: 10px;
    background: var(--bone-warm); border: 1px solid var(--bone-edge);
    border-radius: 14px; padding: 5px 6px;
  }
  .ph-ask-btn { color: var(--ink-muted); display: inline-flex; }
  .ph-ask-input { flex: 1; font-size: 10.5px; color: var(--ink-faint); padding-left: 2px; }
  .ph-ask-send {
    width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
    background: var(--sky); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .ph-foot { text-align: center; font-family: var(--font-display); font-style: italic; font-size: 10.5px; color: var(--ink-muted); margin-top: 6px; }
  .ph-video {
    position: relative; height: 116px; border-radius: var(--r-md);
    background: #23201c; display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  /* A real still behind the play button, dimmed so the control reads. */
  .ph-video-still {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 42%; filter: brightness(0.86);
  }
  .ph-play {
    position: relative; z-index: 1;
    width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.92);
    color: #23201c; font-size: 14px; display: inline-flex; align-items: center; justify-content: center;
    padding-left: 3px;
  }
  .ph-dur { position: absolute; right: 8px; bottom: 6px; font-family: var(--font-mono); font-size: 9px; color: rgba(255,255,255,0.85); }
  .ph-lesson { font-size: 12.5px; font-weight: 600; color: var(--ink); margin-top: 8px; }
  .ph-protect {
    margin-top: 8px; padding: 8px 11px;
    background: var(--peach-tint); border-left: 3px solid var(--peach);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
  }
  .ph-protect-line { font-size: 11.5px; color: var(--ink-soft); display: flex; align-items: center; gap: 5px; }
  .ph-protect-chev { margin-left: auto; color: var(--peach-deep); font-size: 10px; }
  .ph-protect-line strong { font-weight: 700; }
  .ph-protect-sub { font-size: 10px; color: var(--ink-muted); margin-top: 3px; line-height: 1.4; }
  .ph-rows { margin-top: 8px; }
  .ph-row {
    display: flex; align-items: center; gap: 7px;
    font-size: 11.5px; color: var(--ink-soft);
    padding: 5px 2px; border-top: 1px solid var(--bone-edge-soft);
  }
  .ph-row-done { color: var(--moss, #4A5D3F); font-size: 10px; }
  .ph-row-play { color: var(--peach-deep); font-size: 8px; }
  .ph-row--now { color: var(--ink); font-weight: 600; }
  .ph-row--dim { color: var(--ink-faint); }
  .ph-col { display: flex; flex-direction: column; align-items: center; max-width: 320px; }
  .ph-colcap { text-align: center; font-size: var(--t-sm); font-style: italic; color: var(--ink-muted); margin-top: var(--s-4); line-height: 1.5; }
</style>
