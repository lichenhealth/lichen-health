---
// Two realistic phone mockups, side by side (founder 2026-08-05): the
// assistant briefing a member on the left; a protected course recording on
// the right — "Video download, screen recording & AI disabled" as clear
// language. Hand-built in the app's own visual vocabulary (bone, peach,
// hairlines) rather than screenshots, so the scenarios can be ideal.
// PhoneFrame supplies the authentic chrome: true 390:844 proportions, the
// app's top bar and the seven-door bottom nav (founder 2026-08-05).
import PhoneFrame from './PhoneFrame.astro';
---
<div class="ph-pair">
  <div class="ph-col">
  <PhoneFrame initial="G" active="home">
    <svg slot="center" viewBox="0 0 24 24" fill="none">
      <path d="M9.5 3.5a3 3 0 00-3 3v.6a3 3 0 00-2.5 2.95V12a3 3 0 002.5 2.95v.6a3 3 0 003 3h2.5V3.5H9.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <path d="M14.5 3.5a3 3 0 013 3v.6a3 3 0 012.5 2.95V12a3 3 0 01-2.5 2.95v.6a3 3 0 01-3 3H12V3.5h2.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <path d="M9.5 8h-1M9.5 11.5h-1M14.5 8h1M14.5 11.5h1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
    <div class="ph-head">
      <div>
        <p class="ph-title">Your assistant</p>
        <p class="ph-sub">the brief, while you were away</p>
      </div>
    </div>
    <div class="ph-body">
      <div class="ph-card">
        <p><strong>Rosa accepted your trade</strong> — her elderberry syrup for your garden hours. She suggested Thursday afternoon.</p>
      </div>
      <div class="ph-card">
        <p><strong>Two people are waiting at Pine Valley Grange&rsquo;s door</strong> — both woven in by members you trust. Your desk has them ready.</p>
      </div>
      <div class="ph-card ph-card--match">
        <p><strong>A gift matches what you&rsquo;re seeking:</strong> a cedar planter box, offered by someone Melanie trusts, four miles away.</p>
      </div>
      <div class="ph-card">
        <p><strong>Tomorrow:</strong> your 3pm blood draw, then the Grange potluck at 5. Want a reminder to bring the seed packets?</p>
      </div>
      <p class="ph-foot">Carbon decides; silicon organizes.</p>
    </div>
  </PhoneFrame>
  <p class="ph-colcap">The assistant helps you live most fully, organizing your needs digitally so you can spend your time more organically.</p>
  </div>

  <div class="ph-col">
  <PhoneFrame initial="M" active="home" mark={false}>
    <div class="ph-space">
      <span class="ph-space-ava" aria-hidden="true">CK</span>
      <p class="ph-space-name">Curanderismo Kapulli 2026</p>
      <p class="ph-space-kind">Group <svg viewBox="-1 -1 18 16.85" fill="none" stroke-width="1.1">
      <path d="M5.69231 6.26923C7.28543 6.26923 8.57692 4.97774 8.57692 3.38462C8.57692 1.79149 7.28543 0.5 5.69231 0.5C4.09918 0.5 2.80769 1.79149 2.80769 3.38462C2.80769 4.97774 4.09918 6.26923 5.69231 6.26923Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M0.5 14.3462H5.69231H10.8846V13.7207C10.8754 12.8412 10.6435 11.9783 10.2105 11.2129C9.77742 10.4473 9.15742 9.80404 8.40838 9.34309C7.65933 8.88213 6.80567 8.61855 5.92714 8.57696C5.84882 8.57325 5.77052 8.57132 5.69231 8.57115C5.6141 8.57132 5.5358 8.57325 5.45748 8.57696C4.57895 8.61855 3.72529 8.88213 2.97623 9.34309C2.22719 9.80404 1.6072 10.4473 1.17416 11.2129C0.741127 11.9783 0.509186 12.8412 0.5 13.7207V14.3462Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M10.3077 6.26923C11.9008 6.26923 13.1923 4.97774 13.1923 3.38462C13.1923 1.79149 11.9008 0.5 10.3077 0.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M13.1923 14.3463H15.5V13.7207C15.4908 12.8412 15.2588 11.9783 14.8258 11.2129C14.3928 10.4473 13.7728 9.80406 13.0237 9.34311C12.5396 9.04513 12.0116 8.82964 11.4615 8.70327" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
    </svg></p>
    </div>
    <div class="ph-tabs" aria-hidden="true">
      <span class="ph-tab is-on">All</span>
      <span class="ph-tab">Social</span>
      <span class="ph-tab">Actionable</span>
    </div>
    <div class="ph-doors" aria-hidden="true">
      <span class="ph-door">
        <span class="ph-door-circ"><svg viewBox="28 211 30 30" fill="none" stroke-width="1.88"><path d="M43 241C51.2844 241 58 234.284 58 226C58 217.716 51.2844 211 43 211C34.7157 211 28 217.716 28 226C28 234.284 34.7157 241 43 241Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M41.8454 230.615C45.0317 230.615 47.6146 228.032 47.6146 224.846C47.6146 221.66 45.0317 219.077 41.8454 219.077C38.6591 219.077 36.0762 221.66 36.0762 224.846C36.0762 228.032 38.6591 230.615 41.8454 230.615Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M49.9229 232.923L45.9307 228.931" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <em>Search</em>
      </span>
      <span class="ph-door">
        <span class="ph-door-circ"><svg viewBox="61 211 30 30" fill="none" stroke-width="1.88"><path d="M76 241C84.2844 241 91 234.284 91 226C91 217.716 84.2844 211 76 211C67.7157 211 61 217.716 61 226C61 234.284 67.7157 241 76 241Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M76 219.077V232.923" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M69.0762 226H82.9223" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <em>Add</em>
      </span>
      <span class="ph-door ph-door--aioff">
        <span class="ph-door-circ"><svg viewBox="0 0 24 24" fill="none"><path d="M9.5 3.5a3 3 0 00-3 3v.6a3 3 0 00-2.5 2.95V12a3 3 0 002.5 2.95v.6a3 3 0 003 3h2.5V3.5H9.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M14.5 3.5a3 3 0 013 3v.6a3 3 0 012.5 2.95V12a3 3 0 01-2.5 2.95v.6a3 3 0 01-3 3H12V3.5h2.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9.5 8h-1M9.5 11.5h-1M14.5 8h1M14.5 11.5h1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></span>
        <em>AI</em>
      </span>
      <span class="ph-doors-gap"></span>
      <span class="ph-door">
        <span class="ph-door-circ"><svg viewBox="143 836 33 28" fill="none" stroke-width="2.06"><path d="M154.688 858.167H154C148.5 858.167 145.75 857 145.75 851.167V845.333C145.75 840.667 148.5 838.333 154 838.333H165C170.5 838.333 173.25 840.667 173.25 845.333V851.167C173.25 855.833 170.5 858.167 165 858.167H164.313C163.886 858.167 163.474 858.342 163.213 858.633L161.15 860.967C160.243 861.993 158.758 861.993 157.85 860.967L155.788 858.633C155.568 858.377 155.059 858.167 154.688 858.167Z" stroke="currentColor" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <em>Chat</em>
      </span>
      <span class="ph-door ph-door--on">
        <span class="ph-door-circ"><svg viewBox="213 215 20 23" fill="none" stroke-width="1.44"><path d="M223 217.247L232.286 221.873L223 226.5L213.714 221.873L223 217.247Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M217.927 223.984L217.937 229.018C217.937 229.018 219.47 231.351 223 231.351C226.529 231.351 228.071 229.018 228.071 229.018L228.07 223.984" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M215.422 232.416V222.739" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M215.423 236.346C216.366 236.346 217.131 235.466 217.131 234.381C217.131 233.296 216.366 232.417 215.423 232.417C214.479 232.417 213.714 233.296 213.714 234.381C213.714 235.466 214.479 236.346 215.423 236.346Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <em>Courses</em>
      </span>
      <span class="ph-door">
        <span class="ph-door-circ"><svg viewBox="14 12 43 44" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M51.1558 24.2881H20.5484C19.0116 24.2881 17.7659 25.5339 17.7659 27.0706V50.7224C17.7659 52.2592 19.0116 53.505 20.5484 53.505H51.1558C52.6925 53.505 53.9383 52.2592 53.9383 50.7224V27.0706C53.9383 25.5339 52.6925 24.2881 51.1558 24.2881Z"/><path d="M17.9971 26.5371L34.1742 36.0302C34.6454 36.3088 35.2391 36.4614 35.8523 36.4614C36.4654 36.4614 37.0592 36.3088 37.5303 36.0302L53.6757 26.5371"/><path d="M23.3098 29.0881V15.375C23.3098 14.8227 23.7575 14.375 24.3098 14.375H46.4834C47.0357 14.375 47.4834 14.8227 47.4834 15.375V29.7814"/></svg></span>
        <em>Events</em>
      </span>
      <span class="ph-door">
        <span class="ph-door-circ"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 8.8a2.9 2.9 0 1 0 0-5.8 2.9 2.9 0 0 0 0 5.8Z"/><path d="M12 21c-3.9-2.9-6.3-5.2-6.3-7.7 0-1.8 1.4-3.1 3-3.1 1.3 0 2.5.8 3.3 2 .8-1.2 2-2 3.3-2 1.6 0 3 1.3 3 3.1 0 2.5-2.4 4.8-6.3 7.7Z"/></svg></span>
        <em>Members</em>
      </span>
    </div>
    <div class="ph-body">
      <div class="ph-video" role="img" aria-label="A course video player, paused on the Weekend 2 recording.">
        <span class="ph-play" aria-hidden="true">▶</span>
        <span class="ph-dur">1:48:22</span>
      </div>
      <p class="ph-lesson">Curanderismo Training · Weekend 2</p>
      <div class="ph-protect">
        <p class="ph-protect-line">Video download, screen recording &amp; AI — <strong>disabled</strong></p>
        <p class="ph-protect-sub">This teaching stays in the room. A standing promise, made by the teacher, kept by the platform.</p>
      </div>
      <div class="ph-rows">
        <p class="ph-row"><span class="ph-row-done">✓</span> Weekend 1 — opening the four directions</p>
        <p class="ph-row ph-row--now"><span class="ph-row-play">●</span> Weekend 2 — full recording</p>
      </div>
    </div>
  </PhoneFrame>
  <p class="ph-colcap">A teacher&rsquo;s channeled wisdom is protected as her sacred plant allies have requested — downloads off, recording off, and never read by AI, ever.</p>
  </div>
</div>

<style>
  .ph-pair {
    display: flex; justify-content: center; gap: var(--s-6);
    margin-top: var(--s-8); flex-wrap: wrap;
  }
  .ph-head {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 16px 12px; border-bottom: 1px solid var(--bone-edge);
  }
  .ph-title { font-weight: 600; font-size: 14px; color: var(--ink); }
  .ph-sub { font-size: 11px; color: var(--ink-muted); margin-top: 1px; }
  .ph-body { padding: 12px 12px 16px; }
  /* A space's home screen: avatar, name, kind — no banner behind it. */
  .ph-space { text-align: center; padding: 8px 14px 8px; }
  .ph-space-ava {
    width: 52px; height: 52px; border-radius: 50%;
    background: #8E7259; color: #fff;
    font-family: var(--font-display); font-size: 19px;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .ph-space-name { font-family: var(--font-display); font-size: 15px; color: var(--ink); margin-top: 7px; line-height: 1.2; }
  .ph-space-kind {
    font-size: 10.5px; color: var(--ink-muted); margin-top: 2px;
    display: inline-flex; align-items: center; gap: 5px;
  }
  .ph-space-kind svg { width: 15px; height: 15px; color: var(--ink-soft); }
  /* All | Social | Actionable — the same tabs every feed carries, so you can
     browse a space at the highest level (founder 2026-08-05). */
  .ph-tabs { display: flex; gap: 14px; padding: 0 14px 6px; }
  .ph-tab { position: relative; font-size: 11px; font-weight: 300; color: var(--ink); padding-bottom: 4px; }
  .ph-tab.is-on { color: var(--peach-deep); font-weight: 600; }
  .ph-tab.is-on::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0;
    height: 2px; border-radius: 2px; background: var(--peach);
  }
  /* The section doors, in the platform's order: search · add · assistant,
     then the hairline, then this space's own rooms. */
  .ph-doors { display: flex; align-items: flex-start; gap: 4px; padding: 0 8px 8px; }
  .ph-door { display: flex; flex-direction: column; align-items: center; gap: 3px; flex: 1; min-width: 0; }
  .ph-door-circ {
    width: 26px; height: 26px; border-radius: 50%;
    border: 1px solid var(--bone-edge); background: var(--bone-warm); color: var(--ink-soft);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .ph-door-circ svg { width: 13px; height: 13px; }
  .ph-door em {
    font-style: normal; font-family: var(--font-mono); font-size: 5.5px;
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-muted);
  }
  .ph-door--on .ph-door-circ { background: var(--peach); border-color: var(--peach); color: var(--bone-warm); }
  .ph-door--on em { color: var(--peach-deep); }
  .ph-door--aioff .ph-door-circ { color: var(--ink-faint); }
  .ph-door--aioff em { color: var(--ink-faint); }
  .ph-doors-gap { width: 1px; align-self: stretch; background: var(--bone-edge); flex-shrink: 0; margin: 2px 3px; }
  .ph-card {
    background: var(--bone-warm); border: 1px solid var(--bone-edge); border-radius: var(--r-md);
    padding: 10px 12px; margin-bottom: 8px;
  }
  .ph-card p { font-size: 11.5px; line-height: 1.45; color: var(--ink-soft); }
  .ph-card p strong { color: var(--ink); font-weight: 600; }
  .ph-card--match { border-color: var(--peach); background: var(--peach-tint); }
  .ph-foot { text-align: center; font-family: var(--font-display); font-style: italic; font-size: 11px; color: var(--ink-muted); margin-top: 10px; }
  .ph-video {
    position: relative; height: 126px; border-radius: var(--r-md);
    background: #23201c; display: flex; align-items: center; justify-content: center;
  }
  .ph-play {
    width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.92);
    color: #23201c; font-size: 14px; display: inline-flex; align-items: center; justify-content: center;
    padding-left: 3px;
  }
  .ph-dur { position: absolute; right: 8px; bottom: 6px; font-family: var(--font-mono); font-size: 9px; color: rgba(255,255,255,0.85); }
  .ph-lesson { font-size: 12.5px; font-weight: 600; color: var(--ink); margin-top: 8px; }
  .ph-protect {
    margin-top: 8px; padding: 8px 11px;
    background: var(--peach-tint); border-left: 3px solid var(--peach);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
  }
  .ph-protect-line { font-size: 11.5px; color: var(--ink); }
  .ph-protect-line strong { font-weight: 700; }
  .ph-protect-sub { font-size: 10px; color: var(--ink-muted); margin-top: 3px; line-height: 1.4; }
  .ph-rows { margin-top: 8px; }
  .ph-row {
    display: flex; align-items: center; gap: 7px;
    font-size: 11.5px; color: var(--ink-soft);
    padding: 5px 2px; border-top: 1px solid var(--bone-edge-soft);
  }
  .ph-row-done { color: var(--moss, #4A5D3F); font-size: 10px; }
  .ph-row-play { color: var(--peach-deep); font-size: 8px; }
  .ph-row--now { color: var(--ink); font-weight: 600; }
  .ph-row--dim { color: var(--ink-faint); }
  .ph-col { display: flex; flex-direction: column; align-items: center; max-width: 320px; }
  .ph-colcap { text-align: center; font-size: var(--t-sm); font-style: italic; color: var(--ink-muted); margin-top: var(--s-4); line-height: 1.5; }
</style>
