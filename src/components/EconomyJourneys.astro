---
// "The economy in action" — one scene per group the algorithm looks for
// (founder 2026-08-05: "let's create an economy in action mockup for each
// scenario, like we did for Tango"). Each scene is a journey map beside the
// screen that makes it real.
//
// The table's story moved UP to lead the section on the economy; Tango moved
// DOWN here, where she sits beside Crystal, the firefighters, and the young
// people still becoming — the four groups named just above.
import TangoScene from './TangoScene.astro';
import CrystalScene from './CrystalScene.astro';
import FireScene from './FireScene.astro';
import YouthScene from './YouthScene.astro';
---
<div class="ej">
  <h3 class="display h-2 ejsub">The economy in action</h3>
  <p class="wbody">Four routes, drawn — someone carrying wounds, the chronically undervalued, an under-resourced innovator, and a young person still becoming. Four stories, one web, and an assistant weaving every route.</p>

  <div class="ej-scene"><TangoScene /></div>
  <div class="ej-scene"><FireScene /></div>
  <div class="ej-scene"><CrystalScene /></div>
  <div class="ej-scene"><YouthScene /></div>
</div>

<style>
  .ej { margin-top: var(--s-9); }
  .ejsub { margin-bottom: 0; }
  .ej-scene { margin-top: var(--s-8); }
</style>
