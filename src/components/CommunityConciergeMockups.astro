---
// Illustrated phone mockups for the Community/Care pair (founder 2026-08-10:
// "put a mock of Community on the left and Concierge on the right" beneath
// the "each one feeds the other" line). Hand-built from the app's real
// PhoneFrame/AppIcon components — the same illustration technique the
// economy-in-action scenes already use — not literal screenshots.
import PhoneFrame from './PhoneFrame.astro';
import AppIcon from './AppIcon.astro';
---
<div class="ccm">
  <div class="ccm-col">
    <PhoneFrame initial="M" active="home" mark={false} w={260}>
      <div class="ccm-feed">
        <p class="ccm-greet">Good morning. <em>Your web is awake.</em></p>
        <div class="ccm-card">
          <div class="ccm-card-head">
            <span class="ccm-avatar" style="background:#C97B3D">M</span>
            <span class="ccm-card-id">
              <strong>Maya Chen</strong>
              <em>Pine Valley Grange</em>
            </span>
          </div>
          <p class="ccm-card-body">Bring a dish and the seeds you saved — the Grange table has room for both.</p>
          <div class="ccm-card-icons">
            <AppIcon name="shield-user" size={13} />
            <AppIcon name="thumbs-up" size={13} />
            <AppIcon name="message" size={13} />
            <AppIcon name="bookmark" size={13} />
          </div>
        </div>
        <div class="ccm-card">
          <div class="ccm-card-head">
            <span class="ccm-avatar" style="background:#7C8E5E">T</span>
            <span class="ccm-card-id">
              <strong>The Trail Crew</strong>
              <em>Group · Events</em>
            </span>
          </div>
          <p class="ccm-card-body">Loppers, gloves, and good company — we clear the flood debris before fall.</p>
          <div class="ccm-card-icons">
            <AppIcon name="shield-user" size={13} />
            <AppIcon name="thumbs-up" size={13} />
            <AppIcon name="message" size={13} />
            <AppIcon name="bookmark" size={13} />
          </div>
        </div>
      </div>
    </PhoneFrame>
    <p class="ccm-label">Community</p>
  </div>
  <div class="ccm-col">
    <PhoneFrame initial="M" active="concierge" w={260}>
      <div class="ccm-conc">
        <p class="ccm-conc-eyebrow">Web of Wellbeing</p>
        <div class="ccm-wow">
          <svg viewBox="0 0 80 80" class="ccm-wow-ring" aria-hidden="true">
            <circle cx="40" cy="40" r="34" fill="none" stroke="var(--bone-edge)" stroke-width="7" />
            <circle cx="40" cy="40" r="34" fill="none" stroke="var(--peach)" stroke-width="7"
              stroke-linecap="round" stroke-dasharray="213.6" stroke-dashoffset="55"
              transform="rotate(-90 40 40)" />
          </svg>
          <span class="ccm-wow-n">74</span>
        </div>
        <p class="ccm-conc-note">Trending up this week — sleep and movement both improved.</p>
        <p class="ccm-conc-label">Your care team</p>
        <div class="ccm-team">
          <span class="ccm-avatar ccm-avatar--sm" style="background:#A78BBA">R</span>
          <span class="ccm-avatar ccm-avatar--sm" style="background:#5A8B84">D</span>
          <span class="ccm-avatar ccm-avatar--sm" style="background:#C97B3D">J</span>
          <span class="ccm-team-note">3 people tending your care, together</span>
        </div>
        <div class="ccm-next">
          <AppIcon name="concierge" size={15} />
          <span><strong>Next best step</strong><br />Book a check-in with Dr. Reyes this week.</span>
        </div>
      </div>
    </PhoneFrame>
    <p class="ccm-label">Concierge</p>
  </div>
</div>

<style>
  .ccm {
    display: flex; justify-content: center; align-items: flex-start; flex-wrap: wrap;
    gap: var(--s-7); margin: var(--s-5) 0 var(--s-6);
  }
  .ccm-col { display: flex; flex-direction: column; align-items: center; gap: var(--s-3); }
  .ccm-label {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-faint);
  }

  /* ── Community feed mock ─────────────────────────────────────────── */
  .ccm-feed { padding: 10px 12px 14px; display: flex; flex-direction: column; gap: 10px; }
  .ccm-greet { font-size: 12px; color: var(--ink-soft); margin-bottom: 2px; }
  .ccm-greet em { font-style: italic; color: var(--ink); }
  .ccm-card {
    background: var(--bone-warm); border: 1px solid var(--bone-edge); border-radius: var(--r-md);
    padding: 9px 10px;
  }
  .ccm-card-head { display: flex; align-items: center; gap: 7px; }
  .ccm-avatar {
    width: 24px; height: 24px; border-radius: 50%; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; font-size: 10px; font-weight: 600; font-family: var(--font-display);
  }
  .ccm-avatar--sm { width: 20px; height: 20px; font-size: 9px; margin-left: -6px; border: 2px solid var(--bone); }
  .ccm-avatar--sm:first-child { margin-left: 0; }
  .ccm-card-id { display: flex; flex-direction: column; line-height: 1.2; }
  .ccm-card-id strong { font-size: 10.5px; color: var(--ink); font-weight: 600; }
  .ccm-card-id em { font-style: normal; font-size: 9px; color: var(--ink-faint); }
  .ccm-card-body { font-size: 10.5px; line-height: 1.4; color: var(--ink-soft); margin-top: 6px; }
  .ccm-card-icons { display: flex; gap: 9px; margin-top: 8px; color: var(--ink-faint); }
  .ccm-card-icons :global(svg) { width: 13px; height: 13px; }

  /* ── Concierge mock ──────────────────────────────────────────────── */
  .ccm-conc { padding: 12px 14px 16px; display: flex; flex-direction: column; align-items: center; }
  .ccm-conc-eyebrow {
    font-family: var(--font-mono); font-size: 8px; letter-spacing: 0.07em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  .ccm-wow { position: relative; width: 80px; height: 80px; margin-top: 6px; }
  .ccm-wow-ring { width: 80px; height: 80px; }
  .ccm-wow-n {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-size: 22px; color: var(--ink);
  }
  .ccm-conc-note { font-size: 9.5px; font-style: italic; color: var(--ink-muted); text-align: center; margin-top: 6px; max-width: 190px; }
  .ccm-conc-label {
    align-self: flex-start;
    font-family: var(--font-mono); font-size: 8px; letter-spacing: 0.07em; text-transform: uppercase;
    color: var(--ink-faint); margin-top: 16px;
  }
  .ccm-team { display: flex; align-items: center; gap: 8px; margin-top: 6px; width: 100%; }
  .ccm-team-note { font-size: 9px; color: var(--ink-soft); margin-left: 4px; line-height: 1.3; }
  .ccm-next {
    display: flex; align-items: flex-start; gap: 8px; margin-top: 14px; width: 100%;
    background: var(--bone-warm); border: 1px solid var(--peach); border-radius: var(--r-md);
    padding: 9px 10px; color: var(--peach-deep);
  }
  .ccm-next span { font-size: 9.5px; line-height: 1.4; color: var(--ink-soft); }
  .ccm-next strong { color: var(--ink); font-weight: 600; }

  @media (max-width: 640px) {
    .ccm { gap: var(--s-5); }
  }
</style>
