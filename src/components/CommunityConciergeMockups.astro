---
// REAL SCREENSHOTS inside the Community/Care cards (founder 2026-10-05:
// "Audit my concierge…and choose a screen shot that fits, then community,
// do the same" — the hand-drawn micro-mocks were sparse and had drifted:
// retired "awake" greeting, wrong wellbeing axes). Both captured from the
// actual app at 390×844@2x:
//  - community-grange.png — Pine Valley Grange's live community page as a
//    signed-in member: masthead, presence line, the doors row, Home/About
//    tabs, and the real feed (demo-cast posts, demo-marked in the app).
//  - concierge-wow.png — the Concierge board on the standing FPO account
//    (the fictional seasonal-land-worker story): dashboard dropdown, the
//    five tabs, three lenses, overall 73%, the banded six-dimension web.
//    Never a real member's board — the FPO account exists for exactly this.
// Recapture: harness session as the test account, viewport 390×844,
// deviceScaleFactor 2, badges hidden (.nav-badge,.top-bar__badge) and the
// EXAMPLE badge chrome suppressed for the photo only.
export interface Props { variant: 'community' | 'concierge'; w?: number }
const { variant, w = 184 } = Astro.props;
---
<div class="ccm-phone" style={`width:${w}px`}>
  <div class="ccm-notch" aria-hidden="true"></div>
  {variant === 'community' ? (
    <img class="ccm-shot" src="/screens/community-grange.png"
      alt="The Pine Valley Grange community page in the Lichen app: the community's masthead, a presence line, doors into Feed, Chat, Suggest and Marketplace, and a feed of neighborly posts — a work party, canning jars offered as a gift." loading="lazy" />
  ) : (
    <img class="ccm-shot" src="/screens/concierge-wow.png"
      alt="The Concierge board in the Lichen app: WOW, KOC, Chat, Urgent Care and Care Team tabs, three assessment lenses, an overall wellbeing of 73%, and the six-dimension Web of Wellbeing with a score at each point." loading="lazy" />
  )}
</div>

<style>
  .ccm-phone {
    aspect-ratio: 390 / 844;
    border: 3px solid #1a1a1a; border-radius: 13px;
    background: var(--bone); overflow: hidden;
    box-shadow: 0 10px 24px rgba(18, 24, 28, 0.18);
    display: flex; flex-direction: column;
  }
  .ccm-notch { width: 32%; height: 4px; background: #1a1a1a; border-radius: 0 0 4px 4px; margin: 0 auto; flex-shrink: 0; z-index: 1; }
  .ccm-shot { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; margin-top: -4px; }
</style>
