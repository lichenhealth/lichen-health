{isAbout && (
  <script is:inline>
    // FAQ live search — hide items whose question+answer miss the query.
    (function () {
      var input = document.getElementById('wfaq-search');
      var empty = document.getElementById('wfaq-empty');
      if (!input) return;
      var items = Array.prototype.slice.call(document.querySelectorAll('.wfaq-item'));
      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        var shown = 0;
        items.forEach(function (el) {
          var hit = !q || el.textContent.toLowerCase().indexOf(q) !== -1;
          el.hidden = !hit;
          if (hit) shown++;
        });
        empty.hidden = shown > 0;
      });
    })();
    // Partnership inquiry — same HubSpot form the site's signup uses, message
    // prefixed so the founder can spot partnership threads in the contact list.
    (function () {
      var form = document.getElementById('winquiry');
      if (!form) return;
      var status = document.getElementById('winquiry-status');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var data = new FormData(form);
        var name = String(data.get('name') || '').trim().split(' ');
        var fields = [
          { name: 'firstname', value: name[0] || '' },
          { name: 'lastname', value: name.slice(1).join(' ') },
          { name: 'email', value: String(data.get('email') || '').trim() },
          { name: 'message', value: 'PARTNERSHIP INQUIRY — ' + String(data.get('message') || '').trim() },
        ].filter(function (f) { return f.value !== ''; });
        status.textContent = 'Sending…';
        fetch('https://api.hsforms.com/submissions/v3/integration/submit/246356324/66b86cc2-3710-48bd-8c08-c94c1198dc0e', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fields: fields, context: { pageUri: location.href, pageName: document.title } }),
        }).then(function (r) {
          if (!r.ok) throw new Error(String(r.status));
          status.textContent = 'Thank you — a real person will write back soon.';
          form.reset();
