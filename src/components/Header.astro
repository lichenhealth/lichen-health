---
import { logoWhite, logoColor } from '../data/images';
export interface Props { overHero?: boolean }
const { overHero = false } = Astro.props;
// The site now serves lichen.health itself (Shape A, founder 2026-07-31):
// About/Donate/Events/Resources/Blog resolve to the APP's richer versions on
// the same domain; deep functionality (The Economy = the marketplace) is a
// door into membership — "Request to join" IS the answer, because the
// functionality is the membership.
const nav = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Care', href: '/project/care' },
  { label: 'Business', href: '/project/business' },
  { label: 'Platform', href: '/project/platform' },
  { label: 'The Economy', href: '/economy' },
  { label: 'Get Involved', href: '/get-involved' },
  { label: 'Donate', href: '/donate' },
];
---
<header class:list={['fheader', { solid: !overHero }]}>
  <div class="container fnav">
    <a href="/" class="logo brand" aria-label="Lichen home">
      <img src={overHero ? logoWhite : logoColor} alt="Lichen" />
    </a>
    <a href="/login" class="fnav-signin">Sign in</a>
    <button class="fnav-toggle" id="fnavToggle" aria-label="Menu"><span></span><span></span><span></span></button>
    <nav class="fnav-links" id="fnavLinks" aria-label="Primary">
      {nav.map((n) => {
        const path = Astro.url.pathname.replace(/\/$/, '') || '/';
        const here = n.href === '/' ? (path === '/' || path === '/welcome') : path === n.href;
        return <a href={n.href} class:list={[{ 'is-here': here }]} aria-current={here ? 'page' : undefined}>{n.label}</a>;
      })}
    </nav>
  </div>
</header>
<script>
  const t = document.getElementById('fnavToggle');
  const l = document.getElementById('fnavLinks');
  t?.addEventListener('click', () => l?.classList.toggle('open'));
</script>
