---
const nav = [
  { label: 'About', href: '/about' },
  { label: 'Our Story', href: '/ourstory' },
  { label: 'Blog', href: '/blog' },
  { label: 'Resources', href: '/resources' },
  { label: 'Donate', href: '/donate' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Lichen home">
      <img src="/icons/logo.svg" alt="" class="brand-mark" width="28" height="28" />
      <span class="brand-word">Lichen</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} class:list={['nav-link', { 'is-active': path === n.href }]}>{n.label}</a>
      ))}
    </nav>
    <a href="/get-involved" class="btn btn-primary header-cta">Get involved</a>
    <button class="nav-toggle" aria-label="Menu" id="navToggle">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="mobile-nav" id="mobileNav" aria-label="Mobile">
    {nav.map((n) => <a href={n.href} class="mobile-link">{n.label}</a>)}
    <a href="/get-involved" class="btn btn-primary" style="margin-top:8px">Get involved</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bone) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--bone-edge);
  }
  .header-inner { display: flex; align-items: center; gap: var(--s-6); height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; margin-right: auto; }
  .brand-mark { display: block; }
  .brand-word { font-family: var(--font-display); font-size: var(--t-xl); font-weight: 500; letter-spacing: -0.02em; }
  .site-nav { display: flex; gap: var(--s-6); }
  .nav-link { font-size: var(--t-base); font-weight: 400; color: var(--ink-muted); transition: color var(--d-fast) var(--ease-out); }
  .nav-link:hover, .nav-link.is-active { color: var(--ink); }
  .header-cta { padding: 9px 16px; font-size: var(--t-sm); }
  .nav-toggle { display: none; flex-direction: column; gap: 4px; padding: 8px; }
  .nav-toggle span { width: 20px; height: 1.5px; background: var(--ink); display: block; }
  .mobile-nav { display: none; flex-direction: column; gap: var(--s-3); padding: var(--s-5) var(--s-6) var(--s-6); border-top: 1px solid var(--bone-edge); }
  .mobile-link { font-family: var(--font-display); font-size: var(--t-xl); color: var(--ink); }
  @media (max-width: 760px) {
    .site-nav, .header-cta { display: none; }
    .nav-toggle { display: flex; }
    .mobile-nav.open { display: flex; }
  }
</style>
<script>
  const t = document.getElementById('navToggle');
  const m = document.getElementById('mobileNav');
  t?.addEventListener('click', () => m?.classList.toggle('open'));
</script>
