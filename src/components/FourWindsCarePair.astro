---
// THE PAIR UNDER LICHEN'S ROLE (founder 2026-09-01: "add back the equine
// therapy photo (left) and scheduling (right)"): the Concierge care team
// around one person doing equine therapy at Four Winds — Tango ON the team
// (from FourWindsPhones) — beside the find-a-time scheduler adapted from
// FireScene for Four Winds' own resources: the crews become the arena, the
// herd and the practitioners, and BREATHING TIME shows as held time.
import PhoneFrame from './PhoneFrame.astro';
import AppIcon from './AppIcon.astro';
const W = 250;
const DAYS = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const CREW = [
  { who: 'Arena', busy: [0, 1, 4] },
  { who: 'Tango · 2 sessions/day', busy: [1, 2, 5] },
  { who: 'Dr. Reyes', busy: [0, 2, 4] },
  { who: 'Pasture rest', busy: [3, 6] },
];
---
<div class="fwp">
  {/* ── RIGHT · CARE — a Concierge team around one person ──────────────── */}
  <div class="fwp__col">
    <PhoneFrame initial="K" active="concierge" mark={false} w={W}>
      <div class="fwp-head">
        <span class="fwp-ava fwp-ava--care">K</span>
        <span>
          <p class="fwp-name">Kelly&rsquo;s care</p>
          <p class="fwp-sub">Concierge <AppIcon name="concierge" size={11} /> · care team of four</p>
        </span>
      </div>
      <div class="fwp-tabs" aria-hidden="true">
        <span class="fwp-tab is-on">WOW</span>
        <span class="fwp-tab">KOC</span>
        <span class="fwp-tab">Urgent</span>
        <span class="fwp-tab">Care team</span>
      </div>
      <div class="fwp-body">
        <div class="fwp-card fwp-card--now">
          <p><strong>Equine session at Four Winds</strong> — Tuesday 10am, groundwork with Tango before mounting.</p>
          <p class="fwp-mode">On your calendar · with Andrea</p>
        </div>
        <p class="fwp-lbl">Web of Wellbeing</p>
        <div class="fwp-wow">
          <span><em>Nervous system</em><span class="fwp-bar"><i style="width:72%"></i></span></span>
          <span><em>Sleep</em><span class="fwp-bar"><i style="width:64%"></i></span></span>
          <span><em>Connection</em><span class="fwp-bar"><i style="width:81%"></i></span></span>
        </div>
        <div class="fwp-card">
          <p><strong>Dr. Reyes</strong> — &ldquo;Bring boots. We&rsquo;ll keep it on the ground this week and see how the week after sits.&rdquo;</p>
        </div>
        <div class="fwp-team">
          <span>AP</span><span>DR</span><span>MB</span><span class="fwp-team--horse">🐴</span>
          <em>Andrea, Dr. Reyes, Melanie &amp; Tango</em>
        </div>
      </div>
    </PhoneFrame>
    <p class="fwp-cap">The care team forms around the person — and the horse doing the work is a member of it, her contribution counted and reciprocated.</p>
  </div>

  {/* ── RIGHT · SCHEDULING — find-a-time with breathing room ─────────── */}
  <div class="fwp__col">
    <PhoneFrame initial="F" active="calendar" mark={false} w={W}>
      <div class="fir">
        <p class="fir-title">Find a time</p>
        <p class="fir-sub">Four Winds &middot; arena, herd &amp; practitioners</p>
        <div class="fir-grid">
          <div class="fir-row fir-row--head">
            <span class="fir-who"></span>
            {DAYS.map((d) => <span class="fir-day">{d}</span>)}
          </div>
          {CREW.map((c) => (
            <div class="fir-row">
              <span class="fir-who">{c.who}</span>
              {DAYS.map((_, i) => (
                <span class={'fir-cell' + (c.busy.includes(i) ? ' is-busy' : ' is-free')}></span>
              ))}
            </div>
          ))}
        </div>
        <div class="fir-found">
          <span class="fir-found-brain"><AppIcon name="brain" size={13} /></span>
          <p><strong>Thursday morning works</strong> — Tango is fresh, the arena is open, and nobody gives up their rest to make it fit.</p>
        </div>
        <span class="fir-cta">Hold the session</span>
      </div>
    </PhoneFrame>
    <p class="fwp-cap">The scheduler reads every calendar at once — and holds breathing time for the land, the animals and the practitioners as firmly as any session.</p>
  </div>
</div>

<style>
  .fwp {
    display: flex; justify-content: center; gap: var(--s-7);
    margin: var(--s-7) 0 var(--s-8); flex-wrap: wrap;
  }
  .fwp__col { display: flex; flex-direction: column; align-items: center; gap: var(--s-3); max-width: 250px; }
  .fwp-cap { font-size: var(--t-sm); line-height: var(--lh-normal); color: var(--ink-muted); text-align: center; }

  .fwp-head {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 12px 10px; border-bottom: 1px solid var(--bone-edge);
  }
  .fwp-ava {
    width: 30px; height: 30px; border-radius: 9px; flex-shrink: 0;
    background: #8C8F5B; color: #fff; font-size: 10px; font-weight: 600;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .fwp-ava--care { border-radius: 50%; background: var(--peach); font-size: 12px; }
  /* AMH's site leads with warm terracotta — close enough to echo without
     pretending to their brand. */
  .fwp-ava--amh { background: #C4703F; }
  .fwp-name { font-family: var(--font-display); font-size: 12.5px; color: var(--ink); line-height: 1.2; }
  .fwp-sub { font-size: 8.5px; color: var(--ink-muted); display: flex; align-items: center; gap: 4px; }
  .fwp-sub :global(svg) { width: 11px; height: 11px; }

  .fwp-awake {
    padding: 8px 12px 0; font-family: var(--font-display); font-style: italic;
    font-size: 11px; color: var(--peach-deep);
  }

  .fwp-doors { display: flex; gap: 10px; padding: 9px 12px 0; }
  .fwp-doors span { display: flex; flex-direction: column; align-items: center; gap: 3px; }
  .fwp-door {
    width: 24px; height: 24px; border-radius: 50%;
    border: 1px solid var(--bone-edge); color: var(--ink-soft);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .fwp-doors em {
    font-style: normal; font-family: var(--font-mono); font-size: 6px;
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-muted);
  }

  .fwp-tabs { display: flex; gap: 12px; padding: 9px 12px 0; }
  .fwp-tab {
    font-family: var(--font-mono); font-size: 7.5px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ink-muted); padding-bottom: 3px;
  }
  .fwp-tab.is-on { color: var(--peach-deep); border-bottom: 1.5px solid var(--peach); }

  .fwp-body { padding: 10px 12px; display: flex; flex-direction: column; gap: 7px; overflow: hidden; }
  .fwp-lbl {
    font-family: var(--font-mono); font-size: 7px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-faint);
  }
  .fwp-card {
    background: var(--bone-warm); border: 1px solid var(--bone-edge);
    border-radius: 8px; padding: 7px 9px;
  }
  .fwp-card--now { border-color: var(--peach); background: var(--peach-tint); }
  .fwp-card p { font-size: 9px; line-height: 1.45; color: var(--ink-muted); }
  .fwp-card strong { color: var(--ink); font-weight: 500; }
  .fwp-mode { color: var(--peach-deep); margin-top: 3px; }

  .fwp-rows { display: flex; flex-direction: column; gap: 5px; }
  .fwp-rows p {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    font-size: 9px; color: var(--ink-soft);
    padding-bottom: 5px; border-bottom: 1px solid var(--bone-edge);
  }
  .fwp-rows p span { display: inline-flex; align-items: center; gap: 5px; }
  .fwp-rows em {
    font-style: normal; color: var(--peach-deep);
    border: 1px solid var(--peach); border-radius: 999px;
    padding: 2px 7px; font-size: 7.5px;
  }

  .fwp-wow { display: flex; flex-direction: column; gap: 5px; }
  .fwp-wow span { display: flex; align-items: center; gap: 7px; }
  .fwp-wow em { font-style: normal; font-size: 8px; color: var(--ink-muted); width: 66px; flex-shrink: 0; }
  .fwp-bar { display: block; flex: 1; height: 5px; border-radius: 3px; background: var(--bone-edge); }
  .fwp-bar i { display: block; height: 100%; border-radius: 3px; background: var(--peach); }

  .fwp-team { display: flex; align-items: center; gap: 4px; margin-top: 2px; }
  .fwp-team span {
    width: 19px; height: 19px; border-radius: 50%; flex-shrink: 0;
    background: var(--bone-warm); border: 1px solid var(--bone-edge);
    font-size: 7px; color: var(--ink-soft);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .fwp-team--horse { background: rgba(152, 190, 77, 0.2); border-color: rgba(152, 190, 77, 0.6); font-size: 9px; }
  .fwp-team em { font-style: normal; font-size: 7.5px; color: var(--ink-muted); margin-left: 3px; }

  @media (max-width: 620px) {
    .fwp { gap: var(--s-6); }
  }
  .fir { padding: 10px 12px 12px; }
  .fir-title { font-size: 13px; font-weight: 600; color: var(--ink); }
  .fir-sub { font-size: 10px; color: var(--ink-muted); margin-top: 1px; }
  .fir-grid { margin-top: 9px; }
  .fir-row { display: flex; align-items: center; gap: 3px; margin-bottom: 3px; }
  .fir-who {
    width: 78px; flex-shrink: 0; font-size: 8px; color: var(--ink-soft);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .fir-day {
    flex: 1; text-align: center; font-family: var(--font-mono);
    font-size: 7.5px; color: var(--ink-faint);
  }
  .fir-cell { flex: 1; height: 13px; border-radius: 3px; }
  .fir-cell.is-busy { background: var(--bone-edge); }
  .fir-cell.is-free { background: color-mix(in srgb, #98BE4D 40%, transparent); }
  .fir-found {
    display: flex; gap: 7px; align-items: flex-start; margin-top: 9px;
    background: var(--bone-warm); border: 1px solid var(--peach); border-radius: var(--r-md);
    padding: 8px 10px;
  }
  .fir-found-brain { color: var(--peach-deep); flex-shrink: 0; display: inline-flex; }
  .fir-found p { font-size: 10px; line-height: 1.4; color: var(--ink-soft); }
  .fir-found p strong { color: var(--ink); font-weight: 600; }
  .fir-book {
    margin-top: 8px; background: var(--bone-warm); border: 1px solid var(--bone-edge);
    border-radius: var(--r-md); padding: 8px 10px;
  }
  .fir-book-name { font-size: 11.5px; font-weight: 600; color: var(--ink); }
  .fir-book-line { font-size: 9.5px; color: var(--ink-muted); margin-top: 1px; }
  .fir-book-cost { display: flex; flex-direction: column; gap: 2px; margin-top: 6px; }
  .fir-cost-gift { font-size: 9px; color: #B08428; }
  .fir-cost-com { font-size: 9px; color: var(--peach-deep); }
  .fir-cta {
    display: block; margin-top: 9px; text-align: center;
    background: var(--peach); color: #fff; font-size: 11.5px; font-weight: 600;
    padding: 8px 0; border-radius: var(--r-full);
  }
</style>
