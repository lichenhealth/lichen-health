---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="brand"><img src="/icons/logo.svg" alt="" width="26" height="26" /><span>Lichen</span></div>
      <p class="footer-tag">The Holistic Healing Network</p>
    </div>
    <nav class="footer-cols" aria-label="Footer">
      <div class="footer-col">
        <span class="eyebrow">Explore</span>
        <a href="/about">About</a>
        <a href="/ourstory">Our Story</a>
        <a href="/blog">Blog</a>
        <a href="/resources">Resources</a>
      </div>
      <div class="footer-col">
        <span class="eyebrow">Take part</span>
        <a href="/get-involved">Get involved</a>
        <a href="/donate">Donate</a>
        <a href="/events">Events</a>
      </div>
      <div class="footer-col">
        <span class="eyebrow">Connect</span>
        <a href="mailto:connect@lichen.health">connect@lichen.health</a>
      </div>
    </nav>
  </div>
  <div class="container footer-base">
    <span>© {year} Lichen. A nonprofit healing network.</span>
    <a href="/privacy-policy">Privacy</a>
  </div>
</footer>
<style>
  .site-footer { margin-top: var(--s-10); border-top: 1px solid var(--bone-edge); padding-top: var(--s-9); padding-bottom: var(--s-7); background: var(--bone-deep); }
  .footer-inner { display: flex; flex-wrap: wrap; gap: var(--s-9); justify-content: space-between; }
  .footer-brand .brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-size: var(--t-xl); }
  .footer-tag { color: var(--ink-muted); font-size: var(--t-sm); margin-top: var(--s-2); }
  .footer-cols { display: flex; gap: var(--s-9); flex-wrap: wrap; }
  .footer-col { display: flex; flex-direction: column; gap: var(--s-3); }
  .footer-col .eyebrow { margin-bottom: var(--s-1); }
  .footer-col a { font-size: var(--t-base); color: var(--ink-muted); }
  .footer-col a:hover { color: var(--ink); }
  .footer-base { display: flex; justify-content: space-between; margin-top: var(--s-8); padding-top: var(--s-5); border-top: 1px solid var(--bone-edge); font-size: var(--t-sm); color: var(--ink-faint); }
  .footer-base a { color: var(--ink-faint); }
  .footer-base a:hover { color: var(--ink); }
</style>
