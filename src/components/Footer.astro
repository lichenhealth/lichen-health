---
import { logoColor, socials } from '../data/images';
const year = new Date().getFullYear();
---
<footer class="ffooter">
  <div class="container">
    <div class="ffoot-grid">
      <div class="ffoot-logo">
        <img src={logoColor} alt="Lichen" />
        <p class="ffoot-tag">The Holistic Healing Network</p>
      </div>
      <div class="ffoot-col">
        <h4>Learn</h4>
        <a href="/about">About Lichen</a>
        <a href="/project/care">The Care Model</a>
        <a href="/project/business">The Business Model</a>
        <a href="/project/platform">The Platform</a>
        <a href="/resources">Resources</a>
      </div>
      <div class="ffoot-col">
        <h4>Act</h4>
        <a href="/get-involved">Get Involved</a>
        <a href="/donate">Donate Now</a>
        <a href="/events">Events</a>
        <a href="https://billing.stripe.com/p/login/9B6bJ00MU047bRidT3bII00" target="_blank" rel="noopener">Manage Subscription</a>
        <a href="https://billing.stripe.com/p/login/9B6bJ00MU047bRidT3bII00" target="_blank" rel="noopener">Manage Donation</a>
      </div>
      <div class="ffoot-col fsubscribe">
        <h4>Stay Connected</h4>
        <form id="footSub">
          <input type="email" name="email" placeholder="Your email" aria-label="Email" />
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Subscribe</button>
        </form>
        <div class="fsocials">
          <a href={socials.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={socials.facebook} target="_blank" rel="noopener">Facebook</a>
          <a href={socials.youtube} target="_blank" rel="noopener">YouTube</a>
          <a href={socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </div>
    <div class="ffoot-base">
      <span>© Lichen Health {year} — all rights reserved</span>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
</footer>
<script>
  document.getElementById('footSub')?.addEventListener('submit', (e) => {
    e.preventDefault();
    location.href = '/get-involved';
  });
</script>
