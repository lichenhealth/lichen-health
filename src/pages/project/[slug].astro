---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
---
<BaseLayout overHero={true} title={project.seoTitle} description={project.seoDesc}>
  <section class="phero">
    <div class="phero-bg"><img src={project.heroImg} alt="" /></div>
    <div class="container phero-inner">
      <span class="eyebrow proj-eyebrow">{project.eyebrow}</span>
      <h1>{project.title}</h1>
    </div>
  </section>

  <section class="fsection intro-section">
    <div class="container">
      <p class="intro-lead">{project.intro.body}</p>
      {project.intro.learnMore && (
        <a href={project.intro.learnMore.href} class="btn btn-primary btn-up">{project.intro.learnMore.label}</a>
      )}
      <hr class="intro-rule" />
    </div>
  </section>

  {project.sections.map((s, i) => (
    <section class="fsection sec-block">
      <div class:list={['container', 'sec-grid', { flip: i % 2 === 1 }]}>
        {s.img && (
          <div class:list={['sec-pic', { 'sec-pic--composed': s.bgPhoto }]}>
            {s.bgPhoto && (
              <div class="sec-bg"><img src={s.bgPhoto} alt="" loading="lazy" /></div>
            )}
            <img src={s.img} alt="" loading="lazy" class:list={{ 'phone-shot': s.screenshot, 'phone-shot--composed': s.bgPhoto }} />
          </div>
        )}
        <div class="sec-copy">
          {s.title && <h2 class="display sec-title">{s.title}</h2>}
          {s.body.map((para) => <p>{para}</p>)}
        </div>
      </div>
    </section>
  ))}

  <section class="fband proj-cta">
    <div class="container">
      <h2>{project.cta.line}</h2>
      <a href={project.cta.href} class="btn btn-light btn-up">{project.cta.label}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .proj-eyebrow { color: var(--peach-light); }

  .intro-section { padding-bottom: var(--s-6); }
  .intro-lead { font-size: clamp(21px, 2.5vw, 27px); line-height: 1.55; color: var(--ink-soft); font-weight: 300; max-width: 68ch; letter-spacing: -0.01em; }
  .intro-section .btn { margin-top: 26px; }
  .intro-rule { height: 1px; background: #12181C; border: 0; margin-top: var(--s-8); }

  .sec-block { padding-block: var(--s-8); }
  .sec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .sec-grid.flip .sec-pic { order: 2; }
  .sec-pic img { width: 100%; height: auto; display: block; }
  /* Real platform screenshots, framed like the phone they live on (matches about.astro). */
  .sec-pic .phone-shot {
    max-width: 320px; margin-inline: auto;
    border-radius: 28px; border: 1px solid var(--bone-edge);
    box-shadow: 0 18px 44px rgba(18, 24, 28, 0.14);
  }
  /* The teardrop: a real lifestyle photo behind the phone, same composition
     as the original Figma mockups — just with a real screenshot up front.
     Both children are absolutely positioned inside a fixed-aspect box, so
     the layout is deterministic regardless of flip order or image ratio. */
  .sec-pic--composed { position: relative; width: 100%; max-width: 420px; aspect-ratio: 1 / 1.05; }
  .sec-bg {
    position: absolute; top: 0; left: 0;
    width: 80%; aspect-ratio: 1 / 1;
    border-radius: 50%; overflow: hidden;
  }
  .sec-bg img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sec-pic img.phone-shot--composed {
    position: absolute; right: 0; bottom: -4%; z-index: 1;
    width: 56%; height: auto; max-width: none; margin: 0;
  }
  .sec-title { font-size: clamp(24px,3vw,38px); margin-bottom: 18px; }
  .sec-copy p { font-size: 17px; line-height: 1.7; color: var(--ink-soft); font-weight: 300; margin-bottom: 16px; }

  .proj-cta { margin-top: var(--s-8); }

  @media (max-width: 860px) {
    .intro-grid, .sec-grid { grid-template-columns: 1fr; gap: 28px; }
    .sec-grid.flip .sec-pic { order: 0; }
  }
</style>
