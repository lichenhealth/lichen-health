---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import seo from '../data/seo.json';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const meta = (seo as Record<string, any>)[post.slug] || {};
const desc = meta.description || `${post.data.title} — Lichen, the holistic healing network.`;
---
<BaseLayout title={`${post.data.title} — Lichen`} description={desc}>
  <article class="container container--narrow article">
    <a href="/blog" class="back-link">← All writing</a>
    <header class="article-head">
      <span class="eyebrow">Lichen</span>
      <h1 class="display h-1">{post.data.title}</h1>
    </header>
    <hr class="divider" />
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
<style>
  .article { padding-block: var(--s-9); }
  .back-link { color: var(--ink-muted); font-size: var(--t-sm); }
  .back-link:hover { color: var(--ink); }
  .article-head { margin-block: var(--s-6) var(--s-6); display: flex; flex-direction: column; gap: var(--s-3); }
  .divider { margin-bottom: var(--s-7); }
</style>
