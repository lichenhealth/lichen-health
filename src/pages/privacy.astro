---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy — Lichen" description="How Lichen handles your information.">
  <section class="container container--narrow page">
    <span class="eyebrow">Lichen</span>
    <h1 class="display h-1">Privacy</h1>
    <div class="prose">
      <p>Lichen respects your privacy. We collect only the information you choose to share with us — such as your name and email when you join our list — and we use it solely to stay in touch about our work. We never sell your data.</p>
      <p>Questions? Email <a href="mailto:connect@lichen.health">connect@lichen.health</a>.</p>
    </div>
  </section>
</BaseLayout>
<style>.page{padding-block:var(--s-9);display:flex;flex-direction:column;gap:var(--s-4)}</style>
