---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignupForm from '../components/SignupForm.astro';
---
<BaseLayout title="Get Involved — Lichen" description="Join, volunteer and support the holistic healthcare movement. Be part of a community healing itself and the world.">
  <section class="container container--narrow involved">
    <span class="eyebrow">Take part</span>
    <h1 class="display h-1">Join the movement</h1>
    <p class="lede">
      Lichen grows through people. Whether you want to join the community, lend your time,
      help fund care for those who can't afford it, or simply stay close to the work —
      there's a place for you here.
    </p>
    <div class="ways">
      <div class="way"><span class="tag">Join</span><p>Become part of a community practicing reciprocal, holistic care.</p></div>
      <div class="way"><span class="tag tag-moss">Volunteer</span><p>Offer your skills, time, or presence to the network.</p></div>
      <div class="way"><span class="tag">Give</span><p>Fund access to holistic, community-based care for all. <a href="/donate">Donate →</a></p></div>
    </div>
    <hr class="divider" />
    <h2 class="display h-2" style="margin-bottom: var(--s-5)">Start here</h2>
    <SignupForm />
  </section>
</BaseLayout>
<style>
  .involved { padding-block: var(--s-9); display: flex; flex-direction: column; gap: var(--s-4); }
  .lede { font-size: var(--t-xl); color: var(--ink-soft); font-weight: 300; line-height: var(--lh-snug); max-width: 54ch; }
  .ways { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--s-4); margin-block: var(--s-5); }
  .way { padding: var(--s-5); background: var(--bone-warm); border: 1px solid var(--bone-edge); border-radius: var(--r-md); display: flex; flex-direction: column; gap: var(--s-3); }
  .way p { font-size: var(--t-sm); color: var(--ink-muted); }
  .way a { color: var(--peach-deep); }
  .divider { margin-block: var(--s-6); }
  @media (max-width: 760px) { .ways { grid-template-columns: 1fr; } }
</style>
