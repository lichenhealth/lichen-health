---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignupForm from '../components/SignupForm.astro';
import { heroes } from '../data/images';

// Membership tiers — informational now. Joining ALWAYS starts with the free
// three months inside the app; paid plans are chosen there when the trial
// ends. (Stripe Payment Links retired 2026-07: subscribers who paid through
// them never existed in the app's records and hit the paywall.)
const APP = '';   // same domain now — the app IS lichen.health (Shape A, 2026-07-31)
const joinTiers = [
  { name: 'Community', price: '$29', per: '/mo', blurb: 'The whole network — marketplace, courses, library, events, communities, and your trusted web.', url: '/signup', cta: 'Request an invitation' },
  { name: 'Community + Concierge', price: '$99', per: '/mo', blurb: 'Everything in Community, plus hands-on Concierge care — your care team, on-call support, and coordination.', url: '/signup', cta: 'Request an invitation', featured: true },
];
// SEED (founder 2026-07-31): the patrons and donors whose Current-cy grows
// the commons — distinct from joining, preceding the Founders Circle.
const seedTiers = [
  { name: 'Donate', price: 'Any amount', per: '', blurb: 'Tax-deductible. 95% is minted as Current-cy that subsidizes care for those who can\'t afford it; your dollars are permanently dedicated to the commons.', url: '/donate', cta: 'Donate' },
  { name: "Founder's Circle", price: '$5K–$1M', per: '', blurb: "Be part of the team of benefactors who make Lichen's tech platform and pilot location take flight.", url: '/founders-circle', cta: 'Explore the Circle', featured: true },
];
---
<BaseLayout overHero={true} title="Get Involved — Lichen" description="Join Lichen free for three months, volunteer, and support the holistic healthcare movement.">
  <section class="phero">
    <div class="phero-bg"><img src={heroes['get-involved']} alt="" /></div>
    <div class="container phero-inner"><h1>It takes a village</h1></div>
  </section>

  <section class="container container--narrow involved">
    <p class="lede">Because our beliefs create our reality, there are three ways to bring about a better, shared reality — heal yourself, be the change, and scale the change. Whichever calls you, there's a place here.</p>

    <span class="section-word" aria-hidden="true">JOIN</span>
    <div class="support-head" id="tiers" style="scroll-margin-top:96px">
      <span class="eyebrow">Membership</span>
      <h2 class="display h-2">Membership that funds the mission</h2>
      <p class="support-note">Lichen is a nonprofit — membership revenue not needed to run the platform flows back into <strong>subsidizing care for those who can't afford it</strong>. Every plan starts with the same free three months.</p>
    </div>
    <div class="tiers">
      {joinTiers.map((t) => (
        <div class:list={['tier', { featured: t.featured }]}>
          {t.price && <span class="tier-price">{t.price}<span class="tier-per">{t.per}</span></span>}
          <h3 class="tier-name">{t.name}</h3>
          <p class="tier-blurb">{t.blurb}</p>
          {t.url
            ? <a href={t.url} target={t.url.startsWith('/') ? '_self' : '_blank'} rel="noopener" class="btn btn-primary btn-up tier-cta">{t.cta}</a>
            : <span class="give-soon">Coming soon</span>}
        </div>
      ))}
    </div>

    <!-- The front door: the app is live, and the first three months are a gift. -->
    <div class="join-live" id="join" style="scroll-margin-top:96px">
      <span class="eyebrow">The platform is live</span>
      <h2 class="display h-2">Lichen grows by invitation</h2>
      <p class="support-note">Every member arrives through someone already here — woven into their web from day one. It&rsquo;s how a network stays trustworthy enough to hand your care, your work and your exchanges to. <strong>Know someone inside?</strong> Ask them for an invitation. <strong>Don&rsquo;t yet?</strong> Introduce yourself at the door — tell us who you are and what draws you here, and a real person will write back.</p>
      <p class="support-note">Every new member receives <strong>three months of full Concierge membership, free</strong> — the complete platform: your communities and groups, the marketplace, courses and library, events and calendars, concierge care, and a web of people you trust. No card required. When your three months end, choose the membership that fits, right inside the app. And because it's early, your voice carries: <strong>founding members tell us which features they need and help us test the platform</strong> — you won't just use Lichen, you'll shape it.</p>
      <div class="join-ctas">
        <a href="/signup" class="btn btn-primary btn-up">Request an invitation</a>
        <a href="/login" class="join-open">Already invited, or a member? Sign in →</a>
      </div>
    </div>


    <span class="section-word section-word--seed" aria-hidden="true">SEED</span>
    <div class="support-head">
      <span class="eyebrow">Patrons &amp; donors</span>
      <h2 class="display h-2">Grow the commons</h2>
      <p class="support-note">Some bring about the better world with their presence; some seed it with their resources. Donations and founding gifts become <strong>Current-cy that carries real care to real people</strong> — and build the land, the sanctuary, and the platform underneath everything Lichen does.</p>
    </div>
    <div class="tiers tiers--seed">
      {seedTiers.map((t) => (
        <div class:list={['tier', { featured: t.featured }]}>
          {t.price && <span class="tier-price">{t.price}<span class="tier-per">{t.per}</span></span>}
          <h3 class="tier-name">{t.name}</h3>
          <p class="tier-blurb">{t.blurb}</p>
          <a href={t.url} class="btn btn-primary btn-up tier-cta">{t.cta}</a>
        </div>
      ))}
    </div>

    <p class="manage-line">Manage or cancel your subscription, <a href="https://billing.stripe.com/p/login/9B6bJ00MU047bRidT3bII00" target="_blank" rel="noopener">here</a>. Manage or cancel your recurring donation, <a href="https://billing.stripe.com/p/login/9B6bJ00MU047bRidT3bII00" target="_blank" rel="noopener">here</a>.</p>

    <hr class="divider" />

    <h2 id="join-list" class="display h-2" style="margin-bottom:var(--s-5);scroll-margin-top:96px">Not Ready to Join Yet?</h2>
    <p class="form-intro">Leave your details and tell us how you'd like to be involved — we'll keep you close to the work.</p>
    <SignupForm />
  </section>
</BaseLayout>

<style>
  .involved { padding-block: var(--s-9); display: flex; flex-direction: column; gap: var(--s-4); }
  /* Gray all-caps section words: JOIN the mission, SEED the commons. */
  .section-word {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px); letter-spacing: 0.18em;
    color: var(--ink-faint); font-weight: 500; line-height: 1;
    margin-top: var(--s-5);
  }
  .section-word--seed { margin-top: var(--s-7); }
  .tiers--seed { grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 760px) { .tiers--seed { grid-template-columns: 1fr; } }
  .lede { font-size: var(--t-xl); color: var(--ink-soft); font-weight: 300; line-height: var(--lh-snug); max-width: 56ch; }
  .ways { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--s-4); margin-block: var(--s-5); }
  .way { padding: var(--s-5); background: var(--bone-warm); border: 1px solid var(--bone-edge); border-radius: var(--r-md); display: flex; flex-direction: column; gap: var(--s-3); }
  .way p { font-size: var(--t-sm); color: var(--ink-muted); }
  .divider { margin-block: var(--s-7); }

  /* Full width — matches the three-tier grid above it (founder 2026-07-26). */
  .join-live {
    display: flex; flex-direction: column; gap: var(--s-3);
    margin-top: var(--s-4);
    padding: var(--s-6); background: var(--bone-warm);
    border: 2px solid var(--peach); border-radius: var(--r-lg);
  }
  .join-live .support-note { max-width: 72ch; }
  .join-ctas { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-4); margin-top: var(--s-2); }
  .join-open { font-size: var(--t-sm); color: var(--peach-deep); text-decoration: underline; text-underline-offset: 3px; }
  .join-open:hover { color: var(--rust); }

  .support-head { display: flex; flex-direction: column; gap: var(--s-3); max-width: 60ch; }
  .support-note { font-size: var(--t-lg); color: var(--ink-soft); font-weight: 300; line-height: var(--lh-normal); }
  .support-note strong { color: var(--ink); font-weight: 500; }
  .tiers { display: grid; grid-template-columns: repeat(3,1fr); gap: var(--s-4); margin-top: var(--s-6); }
  .tier { position: relative; padding: var(--s-6); background: var(--bone-warm); border: 2px solid var(--peach); border-radius: var(--r-lg); display: flex; flex-direction: column; gap: var(--s-3); }
  .tier.featured { box-shadow: var(--sh-card); }
  .tier-badge { position: absolute; top: -10px; left: var(--s-6); background: var(--peach); color: #fff; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 500; padding: 3px 10px; border-radius: var(--r-full); }
  .tier-price { font-family: var(--font-display); font-size: var(--t-3xl); color: var(--ink); line-height: 1; }
  .tier-per { font-family: var(--font-body); font-size: var(--t-base); color: var(--ink-muted); font-weight: 300; }
  .tier-name { font-family: var(--font-display); font-weight: 400; font-size: var(--t-xl); color: var(--ink); }
  .tier-blurb { font-size: var(--t-sm); color: var(--ink-muted); line-height: var(--lh-normal); flex: 1; }
  .tier-cta { position: absolute; bottom: -16px; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: var(--t-xs); padding: 8px 16px; }
  .give-soon { margin-top: var(--s-2); font-size: var(--t-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
  .form-intro { font-size: var(--t-base); color: var(--ink-muted); margin-top: calc(-1 * var(--s-3)); margin-bottom: var(--s-5); max-width: 52ch; }

  @media (max-width: 760px) { .ways, .tiers { grid-template-columns: 1fr; } }
  .manage-line { text-align: center; font-size: var(--t-sm); color: var(--ink-muted); margin: var(--s-6) 0 0; }
  .manage-line a { color: var(--peach-deep); text-decoration: underline; text-underline-offset: 2px; }
</style>
