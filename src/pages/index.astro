---
import BaseLayout from '../layouts/BaseLayout.astro';
import { heroes, galynPhoto } from '../data/images';
const projects = [
  { name: 'Care', href: '/project/care', img: heroes['care-model'] },
  { name: 'Business', href: '/project/business', img: heroes['business'] },
  { name: 'Platform', href: '/project/platform', img: heroes['platform'] },
];
---
<BaseLayout
  overHero={true}
  title="Lichen — Because healing the world starts with ourselves"
  description="A holistic healing network that connects people to the land, plants, animals, elements, healers and modern medical technology necessary to awaken their innate power to heal."
>
  <section class="phero tall">
    <div class="phero-bg"><img src={heroes.home} alt="" /></div>
    <div class="container phero-inner">
      <h1>Because healing the world starts with ourselves</h1>
      <p class="lead">We are a nonprofit on a mission to reduce human suffering and expand human consciousness, in community and in reciprocity with the land.</p>
      <div class="phero-actions">
        <a href="https://lichen.healthcare/signup" class="btn btn-primary btn-up">Request an invitation</a>
        <a href="/get-involved" class="btn btn-light btn-up">Get Involved</a>
        <p class="phero-note">Lichen grows by invitation — every member arrives through someone already here. Tell us who you are; a real person reads every note.</p>
      </div>
    </div>
  </section>

  <section class="fsection">
    <div class="container welcome-grid">
      <div class="welcome-pic"><img src={galynPhoto} alt="Galyn" /></div>
      <div class="welcome-copy">
        <span class="eyebrow">Welcome</span>
        <h2 class="display">Where Ancient Wisdom Meets Modern Medicine</h2>
        <p>Galyn is a tech professional turned trauma therapist. After years of watching people heal themselves with proper resourcing and support, she felt called to found a social network that weaves earth wisdom with modern science and technology to bring community-based, earth-based, holistic functional medicine to all.</p>
        <a href="/ourstory" class="btn btn-primary btn-up">Our Story</a>
      </div>
    </div>
  </section>

  <section class="fband">
    <div class="container">
      <h2>Lichen puts you at the center of your care</h2>
      <a href="https://www.youtube.com/watch?v=dCNrSoiUSSs" target="_blank" rel="noopener" class="btn btn-light btn-up">▶ See our video</a>
    </div>
  </section>

  <section class="fsection">
    <div class="container">
      <div class="proj-head" style="text-align:center;margin-bottom:48px">
        <span class="eyebrow">What we're building</span>
        <h2 class="display" style="font-size:clamp(26px,3.4vw,40px);margin-top:10px">Three projects, one mission</h2>
      </div>
      <div class="fproj-grid">
        {projects.map((p) => (
          <a class="fproj" href={p.href}>
            <div class="pic"><img src={p.img} alt={p.name} /></div>
            <div class="body"><h3>{p.name}</h3><span class="more">Explore →</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="fdonate">
    <div class="fdonate-bg"><img src={heroes.donate} alt="" /></div>
    <div class="container fdonate-inner">
      <h2>Make a tax-deductible donation to expand access to holistic, community-based care for all. Thank you for investing in a more balanced and healthy future.</h2>
      <a href="/donate" class="btn btn-primary btn-up">Donate</a>
    </div>
  </section>
</BaseLayout>

<style>
  .welcome-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 64px; align-items: center; }
  .welcome-pic img { width: 100%; height: auto; display: block; }
  .welcome-copy h2 { font-size: clamp(28px,3.4vw,44px); line-height: 1.08; margin: 14px 0 22px; }
  .welcome-copy p { font-size: 18px; color: var(--ink-soft); line-height: 1.65; font-weight: 300; margin-bottom: 26px; max-width: 52ch; }
  @media (max-width: 860px) { .welcome-grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
