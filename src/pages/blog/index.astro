---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { heroes } from '../../data/images';
const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
function excerpt(body){
  const fp = body.split('\n\n').find((p) => p.trim() && !p.startsWith('#') && !p.startsWith('---')) || '';
  const c = fp.replace(/[#*_>\[\]]/g,'').replace(/\(https?:[^)]+\)/g,'').trim();
  return c.length>170 ? c.slice(0,170).trim()+'…' : c;
}
const order=['vision','mission','ourstory','care-model','platform','business','conscious-economy','opportunity','pilot','safety','social-networks'];
const sorted=[...posts].sort((a,b)=>order.indexOf(a.slug)-order.indexOf(b.slug));
---
<BaseLayout overHero={true} title="Writing — Lichen" description="Essays on holistic healing, community and reciprocity from the Lichen network.">
  <section class="phero">
    <div class="phero-bg"><img src={heroes.blog} alt="" /></div>
    <div class="container phero-inner"><h1>From the network</h1></div>
  </section>
  <section class="container">
    <div class="blog-list">
      {sorted.map((p) => (
        <a href={`/${p.slug}`} class="blog-item">
          <h2 class="blog-item-title">{p.data.title}</h2>
          <p class="blog-item-excerpt">{excerpt(p.body)}</p>
          <span class="blog-item-link">Read →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
<style>
  .blog-list{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--s-5);padding-block:var(--s-9)}
  .blog-item{display:flex;flex-direction:column;gap:var(--s-3);padding:var(--s-7);background:var(--bone-warm);border:1px solid var(--bone-edge);border-radius:var(--r-lg);transition:transform var(--d-base) var(--ease-out),border-color var(--d-fast) var(--ease-out)}
  .blog-item:hover{transform:translateY(-2px);border-color:var(--peach)}
  .blog-item-title{font-family:var(--font-display);font-weight:400;font-size:var(--t-2xl);line-height:var(--lh-tight)}
  .blog-item-excerpt{color:var(--ink-muted);font-size:var(--t-base)}
  .blog-item-link{color:var(--peach-deep);font-size:var(--t-sm);margin-top:auto}
  @media(max-width:760px){.blog-list{grid-template-columns:1fr}}
</style>
