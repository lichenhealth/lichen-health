---
import BaseLayout from '../layouts/BaseLayout.astro';
import { heroes } from '../data/images';
import { resources } from '../data/resources';
---
<BaseLayout overHero={true} title="Resources — Lichen" description="Books, podcasts and other resources to help you heal your mind, body, spirit, community and environment.">
  <section class="phero">
    <div class="phero-bg"><img src={heroes.resources} alt="" style="object-position: 50% 28%;" /></div>
    <div class="container phero-inner"><h1>Resources</h1></div>
  </section>

  <section class="container container--narrow res-wrap">
    <p class="lede">A starting library across psychology, biology and spirituality. More to come.</p>

    {resources.map((topic) => (
      <div class="res-topic">
        <h2 class="display res-topic-title">{topic.topic}</h2>
        {topic.groups.map((group) => (
          <div class="res-group">
            {group.label && <h3 class="res-group-label">{group.label}</h3>}
            <ul class="res-items">
              {group.items.map((item) => (
                <li class="res-item">
                  <a href={item.url} target="_blank" rel="noopener" class="res-link">{item.title}</a>
                  <span class="res-note">{item.note}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <hr class="res-rule" />
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .res-wrap { padding-block: var(--s-9); }
  .lede { font-size: var(--t-xl); color: var(--ink-soft); font-weight: 300; margin-bottom: var(--s-9); }
  .res-topic { margin-bottom: var(--s-7); }
  .res-topic-title { font-size: clamp(24px,3.2vw,38px); margin-bottom: var(--s-5); }
  .res-group { margin-bottom: var(--s-6); }
  .res-group-label { font-family: var(--font-mono); font-size: var(--t-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: var(--s-4); }
  .res-items { display: flex; flex-direction: column; gap: var(--s-4); }
  .res-item { display: flex; flex-direction: column; gap: 3px; }
  .res-link { font-family: var(--font-display); font-weight: 400; font-size: var(--t-lg); color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--peach); text-decoration-thickness: 1px; width: fit-content; }
  .res-link:hover { color: var(--peach-deep); }
  .res-note { font-size: var(--t-sm); color: var(--ink-muted); line-height: var(--lh-normal); }
  .res-rule { height: 1px; background: #12181C; border: 0; margin-top: var(--s-7); }
  .res-topic:last-child .res-rule { display: none; }
</style>
